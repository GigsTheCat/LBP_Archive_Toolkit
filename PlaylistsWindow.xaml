<Window x:Class="LbpArchiveToolkit.PlaylistsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:LbpArchiveToolkit.Utils"
        Title="Playlists" Height="850" Width="1300"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" WindowStyle="None" BorderThickness="0"
        AllowsTransparency="True" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" CornerRadius="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BtnActionBlue" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpCyan}"/>
            <Setter Property="Foreground" Value="#002D3D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7EE0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpPink}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A9F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="BtnExtract" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpEmerald}"/>
            <Setter Property="Foreground" Value="#003D2A"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="20,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#38E8B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgPrimary}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                <Setter Property="Padding" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,8,8,16"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <ContentControl Template="{DynamicResource AnimatedBgTemplate}" IsHitTestVisible="False"/>

            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="32" Background="Transparent">
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="─" Style="{DynamicResource TitleBarBtn}" Click="TitleBar_Minimize_Click"/>
                        <Button Content="◻" Style="{DynamicResource TitleBarBtn}" Click="TitleBar_Maximize_Click"/>
                        <Button Content="✕" Style="{DynamicResource TitleBarCloseBtn}" Click="TitleBar_Close_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="20,20,20,25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PLAYLISTS" Foreground="{DynamicResource LbpPink}" FontSize="20" FontWeight="Black" Margin="0,0,0,15"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT PANE: PLAYLISTS -->
                        <ContentControl Grid.Column="0" Style="{DynamicResource PopitCard}" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="dgPlaylists" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
                                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#15FFFFFF" 
                                          Foreground="{DynamicResource FgPrimary}" BorderThickness="0" GridLinesVisibility="None" 
                                          HeadersVisibility="Column" AutoGenerateColumns="False" RowHeight="32" IsReadOnly="True" Margin="0,0,0,15">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NAME" Width="*" Binding="{Binding Name}" ElementStyle="{DynamicResource DataGridTextCenterStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="1">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="NEW" Style="{DynamicResource BtnActionBlue}" Padding="6" Command="{Binding CreateCommand}"/>
                                        <Button Grid.Column="2" Content="RENAME" Style="{DynamicResource BtnSecondary}" Padding="6" Command="{Binding RenameCommand}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="IMPORT SHARE CODE" Style="{DynamicResource BtnSecondary}" Padding="6" FontSize="10" Command="{Binding ImportCommand}"/>
                                        <Button Grid.Column="2" Content="COPY SHARE CODE" Style="{DynamicResource BtnSecondary}" Padding="6" FontSize="10" Command="{Binding ExportCommand}"/>
                                    </Grid>
                                    <Button Content="DELETE" Style="{DynamicResource BtnSecondary}" Padding="6" Margin="0,0,0,15" Command="{Binding DeleteCommand}"/>

                                    <Button Content="DOWNLOAD ALL" Style="{DynamicResource BtnExtract}" Padding="10" Margin="0,0,0,6" FontSize="13" Command="{Binding DownloadAllCommand}"/>
                                    <Button Content="DOWNLOAD TO ZIP" Style="{DynamicResource BtnExtract}" Padding="10" FontSize="13" Command="{Binding ZipAllCommand}"/>
                                </StackPanel>
                            </Grid>
                        </ContentControl>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderSubtle}" Cursor="SizeWE" Margin="0,20"/>

                        <!-- CENTER PANE: LEVELS -->
                        <ContentControl Grid.Column="2" Style="{DynamicResource PopitCard}" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="{Binding PlaylistTitle}" Foreground="{DynamicResource LbpCyan}" FontSize="18" FontWeight="Black" Margin="0,0,0,15" TextAlignment="Center"/>

                                <DataGrid x:Name="dgLevels" Grid.Row="1" ItemsSource="{Binding LevelsInPlaylist}" SelectedItem="{Binding SelectedLevel}"
                                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#15FFFFFF" 
                                          Foreground="{DynamicResource FgPrimary}" BorderThickness="0" GridLinesVisibility="None" 
                                          HeadersVisibility="Column" AutoGenerateColumns="False" RowHeight="32" IsReadOnly="True" Margin="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="LEVEL NAME" Width="*" Binding="{Binding LevelName}" ElementStyle="{DynamicResource DataGridTextCenterStyle}"/>
                                        <DataGridTemplateColumn Header="CREATOR" Width="150" SortMemberPath="Creator">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Creator}" Style="{DynamicResource DataGridTextCenterStyle}" utils:CreatorPreviewBehavior.CreatorName="{Binding Creator}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="GAME" Width="80" Binding="{Binding Game}" ElementStyle="{DynamicResource DataGridTextCenterStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </ContentControl>

                        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderSubtle}" Cursor="SizeWE" Margin="0,20"/>

                        <!-- RIGHT PANE: DETAILS -->
                        <ContentControl Grid.Column="4" Style="{DynamicResource PopitCard}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="*"/>    
                                    <RowDefinition Height="Auto"/> 
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Width="180" Height="180" Margin="0,0,0,15">
                                    <Ellipse Fill="Black" Opacity="0.3" Margin="-3" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><TranslateTransform Y="8"/></Ellipse.RenderTransform>
                                        <Ellipse.Effect><BlurEffect Radius="12"/></Ellipse.Effect>
                                    </Ellipse>
                                    
                                    <!-- Ribbon Background Elements for MM Pick -->
                                    <Path x:Name="mmPickTails" Visibility="{Binding SelectedLevel.IsMmPick, FallbackValue=Collapsed, TargetNullValue=Collapsed, Converter={StaticResource BoolToVis}}" Data="M 90,140 L 40,240 L 75,220 L 90,190 L 105,220 L 140,240 Z" Fill="{DynamicResource LbpPink}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-45">
                                        <Path.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/></Path.Effect>
                                    </Path>
                                    <Ellipse x:Name="mmPickRosette" Visibility="{Binding SelectedLevel.IsMmPick, FallbackValue=Collapsed, TargetNullValue=Collapsed, Converter={StaticResource BoolToVis}}" Margin="-12" Stroke="{DynamicResource LbpPink}" StrokeThickness="16" StrokeDashArray="2 1.5" StrokeDashCap="Flat" />
                                    <Ellipse x:Name="mmPickRosetteInner" Visibility="{Binding SelectedLevel.IsMmPick, FallbackValue=Collapsed, TargetNullValue=Collapsed, Converter={StaticResource BoolToVis}}" Margin="-4" Stroke="#B80E5B" StrokeThickness="4" />

                                    <Ellipse x:Name="iconEllipse" StrokeThickness="5" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Stroke" Value="{DynamicResource LbpOrange}" />
                                                <Setter Property="Fill">
                                                    <Setter.Value>
                                                        <MultiBinding Converter="{StaticResource IconToBrush}">
                                                            <Binding Path="IconSource" />
                                                            <Binding Path="SelectedLevel.IsLocked" FallbackValue="False" />
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedLevel.IsMmPick}" Value="True">
                                                        <Setter Property="Stroke" Value="{DynamicResource LbpPink}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding IconScale}" ScaleY="{Binding IconScale}"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy Image" Command="{Binding CopyImageCommand}" CommandParameter="{Binding IconSource}" />
                                                <MenuItem Header="Save Image..." Command="{Binding SaveImageCommand}" CommandParameter="{Binding IconSource}" />
                                            </ContextMenu>
                                        </Ellipse.ContextMenu>
                                    </Ellipse>

                                    <Path x:Name="lockSymbol" Visibility="{Binding IsIconLockVisible, Converter={StaticResource BoolToVis}}" Data="M9 11V7c0-2.76 2.24-5 5-5s5 2.24 5 5v4h1a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2H8a2 2 0 0 1 -2 -2V13a2 2 0 0 1 2 -2h1zm2 0h6V7a3 3 0 0 0 -6 0v4z" Fill="{DynamicResource FgPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Stretch="Uniform" Width="64" Height="80">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="1.0" Color="Black" Direction="270"/>
                                        </Path.Effect>
                                    </Path>
                                    
                                    <TextBlock x:Name="txtIconStatus" Text="{Binding IconStatusText}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <TextBlock x:Name="txtLevelTitle" Text="{Binding LevelTitle}" Foreground="{DynamicResource FgPrimary}" FontWeight="Black" FontSize="20" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock x:Name="txtCreator" Text="{Binding LevelCreator}" utils:CreatorPreviewBehavior.CreatorName="{Binding SelectedLevel.Creator}" Foreground="{DynamicResource LbpCyan}" FontWeight="SemiBold" FontSize="13" Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>

                                <DockPanel Grid.Row="2" Margin="0,0,0,20">
                                    <TextBlock DockPanel.Dock="Top" Text="DESCRIPTION" Foreground="{DynamicResource LbpPink}" FontWeight="Black" FontSize="12" Margin="0,0,0,6"/>
                                    <Border Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="2" CornerRadius="12" Padding="12">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="txtDescription" Text="{Binding LevelDescription}" Foreground="{DynamicResource FgPrimary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Border>
                                </DockPanel>

                                <StackPanel Grid.Row="3">
                                    <Button x:Name="btnRemove" Content="REMOVE LEVEL" 
                                            Style="{DynamicResource BtnSecondary}" Margin="0,0,0,10" 
                                            Command="{Binding RemoveLevelCommand}" CommandParameter="{Binding SelectedItems, ElementName=dgLevels}"/>
                                            
                                    <Button x:Name="btnExtract" Content="EXTRACT &amp; BACKUP" 
                                            Style="{DynamicResource BtnExtract}" 
                                            Command="{Binding ExtractLevelCommand}" CommandParameter="{Binding SelectedItems, ElementName=dgLevels}"/>
                                </StackPanel>
                            </Grid>
                        </ContentControl>
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>