<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="AnimatedBgTemplate" TargetType="ContentControl">
        <Grid /> <!-- Left empty so it defaults to the basic static color -->
    </ControlTemplate>

    <!-- ========================================== -->
    <!-- 1. PROCEDURAL CRAFT TEXTURES (PURE XAML)   -->
    <!-- ========================================== -->

    <!-- Denim / Woven Canvas Background (Easy on the eyes, rich dark blue/grey) -->
    <DrawingBrush x:Key="BgPrimary" Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#1B222C">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#08FFFFFF" Thickness="1"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,4" EndPoint="16,4"/>
                            <LineGeometry StartPoint="0,12" EndPoint="16,12"/>
                            <LineGeometry StartPoint="4,0" EndPoint="4,16"/>
                            <LineGeometry StartPoint="12,0" EndPoint="12,16"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#15000000" Thickness="1"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,8" EndPoint="16,8"/>
                            <LineGeometry StartPoint="8,0" EndPoint="8,16"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Dark Cardboard -->
    <DrawingBrush x:Key="BgCard" Viewport="0,0,60,60" ViewportUnits="Absolute" TileMode="Tile">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#382920">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,60,60"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#10000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.5"/>
                            <GradientStop Color="#0A000000" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,15,60"/>
                            <RectangleGeometry Rect="15,0,15,60"/>
                            <RectangleGeometry Rect="30,0,15,60"/>
                            <RectangleGeometry Rect="45,0,15,60"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#1A000000">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="8,12" RadiusX="1" RadiusY="1"/>
                            <EllipseGeometry Center="25,40" RadiusX="1.5" RadiusY="0.5"/>
                            <EllipseGeometry Center="45,20" RadiusX="0.5" RadiusY="1"/>
                            <EllipseGeometry Center="52,50" RadiusX="1" RadiusY="1"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Dark Deep Felt Pocket -->
    <DrawingBrush x:Key="BgCardDarker" Viewport="0,0,20,20" ViewportUnits="Absolute" TileMode="Tile">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#1E140F">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,20,20"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#08FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="5,5" RadiusX="1" RadiusY="1"/>
                            <EllipseGeometry Center="15,15" RadiusX="1" RadiusY="1"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Color Palette -->
    <SolidColorBrush x:Key="FgPrimary" Color="#F2E6D8"/>
    <SolidColorBrush x:Key="FgSecondary" Color="#B5A18F"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#5A4334"/>

    <!-- Glossy Buttons Brushes -->
    <LinearGradientBrush x:Key="LbpOrange" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFB703" Offset="0"/>
        <GradientStop Color="#D67600" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LbpPink" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F72585" Offset="0"/>
        <GradientStop Color="#B80E5B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LbpCyan" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4CC9F0" Offset="0"/>
        <GradientStop Color="#0096C7" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LbpEmerald" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#06D6A0" Offset="0"/>
        <GradientStop Color="#049B73" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="TackMetal" GradientOrigin="0.3,0.3" Center="0.5,0.5">
        <GradientStop Color="#FFFFFF" Offset="0.0"/>
        <GradientStop Color="#9E9E9E" Offset="0.3"/>
        <GradientStop Color="#424242" Offset="0.8"/>
        <GradientStop Color="#212121" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- ========================================== -->
    <!-- 2. CRAFT UI STYLES                         -->
    <!-- ========================================== -->

    <!-- Cardboard Popit Card as a Templated ContentControl -->
    <Style x:Key="PopitCard" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="BorderBrush" Value="#4A3018"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <!-- Outer Grid extends layout slightly so tacks aren't clipped -->
                    <Grid Margin="12">
                        <!-- Card Shadow -->
                        <Border CornerRadius="16" Background="#000000" Margin="2,6,-2,-6" Opacity="0.4">
                            <Border.Effect>
                                <BlurEffect Radius="12"/>
                            </Border.Effect>
                        </Border>

                        <!-- Main Cardboard Body -->
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#50FFFFFF" 
                                BorderThickness="1" 
                                CornerRadius="16">
                            <Grid>
                                <!-- Cardboard Edge highlight (bottom right darker, top left lighter) -->
                                <Border CornerRadius="16" BorderBrush="#80000000" BorderThickness="0,0,2,3"/>
                                
                                <!-- Inner Stitching / Paper texture -->
                                <Rectangle Stroke="#2A1B12" StrokeThickness="2" StrokeDashArray="3 3" StrokeDashCap="Round" Margin="6" RadiusX="10" RadiusY="10" Opacity="0.4"/>
                                <Rectangle Stroke="#80FFFFFF" StrokeThickness="1" StrokeDashArray="6 6" Margin="7" RadiusX="9" RadiusY="9" Opacity="0.2"/>
                                
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>

                        <!-- Metal Tacks in Corners -->
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0">
                            <Ellipse Width="24" Height="24" Fill="#000000" Opacity="0.3" Margin="0,3,0,-3"><Ellipse.Effect><BlurEffect Radius="3"/></Ellipse.Effect></Ellipse>
                            <Ellipse Width="24" Height="24" Fill="{DynamicResource TackMetal}" Stroke="#30000000" StrokeThickness="1"/>
                        </Grid>
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0">
                            <Ellipse Width="24" Height="24" Fill="#000000" Opacity="0.3" Margin="0,3,0,-3"><Ellipse.Effect><BlurEffect Radius="3"/></Ellipse.Effect></Ellipse>
                            <Ellipse Width="24" Height="24" Fill="{DynamicResource TackMetal}" Stroke="#30000000" StrokeThickness="1"/>
                        </Grid>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6,0,0,-6">
                            <Ellipse Width="24" Height="24" Fill="#000000" Opacity="0.3" Margin="0,3,0,-3"><Ellipse.Effect><BlurEffect Radius="3"/></Ellipse.Effect></Ellipse>
                            <Ellipse Width="24" Height="24" Fill="{DynamicResource TackMetal}" Stroke="#30000000" StrokeThickness="1"/>
                        </Grid>
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6">
                            <Ellipse Width="24" Height="24" Fill="#000000" Opacity="0.3" Margin="0,3,0,-3"><Ellipse.Effect><BlurEffect Radius="3"/></Ellipse.Effect></Ellipse>
                            <Ellipse Width="24" Height="24" Fill="{DynamicResource TackMetal}" Stroke="#30000000" StrokeThickness="1"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glossy 3D Sticker Buttons -->
    <Style x:Key="BubbleButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="shadow" Background="#000000" CornerRadius="16" Margin="0,4,0,-4" Opacity="0.3">
                            <Border.Effect>
                                <BlurEffect Radius="6"/>
                            </Border.Effect>
                        </Border>

                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            
                            <Grid>
                                <!-- Glossy Top Highlight -->
                                <Border CornerRadius="15,15,4,4" Margin="2,2,2,0" Height="14" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#60FFFFFF" Offset="0"/>
                                            <GradientStop Color="#10FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1.5" Opacity="0.6" Color="Black" Direction="270"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bgBorder" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="shadow" Property="Margin" Value="0,6,0,-6"/>
                            <Setter TargetName="shadow" Property="Opacity" Value="0.4"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bgBorder" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="shadow" Property="Margin" Value="0,2,0,-2"/>
                            <Setter TargetName="shadow" Property="Opacity" Value="0.2"/>
                            <Setter TargetName="bgBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#40000000"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>