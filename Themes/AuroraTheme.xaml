<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="AnimatedBgTemplate" TargetType="ContentControl">
        <Grid />
    </ControlTemplate>

    <!-- ========================================================= -->
    <!-- 1. DETAILED OBSIDIAN AURORA TEXTURES (PURE XAML)          -->
    <!-- ========================================================= -->

    <!-- Starry Velvet Void layered with Deep Red & Northern Lights Emerald waves -->
    <DrawingBrush x:Key="BgPrimary" Viewport="0,0,160,160" ViewportUnits="Absolute" TileMode="Tile">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Deep Obsidian Base -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="1.0" RadiusY="1.0" GradientOrigin="0.5,0.5">
                            <GradientStop Color="#090203" Offset="0"/>
                            <GradientStop Color="#030000" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,160,160"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Subtle Crimson Aurora Ripple -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A99001C" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 0,20 C 40,40 120,0 160,30 L 160,60 C 120,30 40,70 0,50 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                
                <!-- Ghostly Aurora Green Ribbon -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#1A00FF87" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.8"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 0,110 C 30,80 110,130 160,100 L 160,120 C 110,150 30,100 0,130 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Soft stardust cluster -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FFFFFF" Opacity="0.12"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="40,25" RadiusX="0.8" RadiusY="0.8"/>
                            <EllipseGeometry Center="130,55" RadiusX="0.6" RadiusY="0.6"/>
                            <EllipseGeometry Center="75,105" RadiusX="1.0" RadiusY="1.0"/>
                            <EllipseGeometry Center="15,145" RadiusX="0.5" RadiusY="0.5"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Translucent Carbon-Glass panel well -->
    <SolidColorBrush x:Key="BgCard" Color="#120608" Opacity="0.94"/>
    <SolidColorBrush x:Key="BgCardDarker" Color="#070102"/>

    <!-- High-sheen stark typography -->
    <SolidColorBrush x:Key="FgPrimary" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="FgSecondary" Color="#FF6B8B"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#4A0E17"/>

    <!-- Intense High-Sheen Laser Gradients -->
    <!-- Burning Flare Orange -->
    <LinearGradientBrush x:Key="LbpOrange" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF6A00" Offset="0"/>
        <GradientStop Color="#B20000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Neon Crimson Red -->
    <LinearGradientBrush x:Key="LbpPink" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF004C" Offset="0"/>
        <GradientStop Color="#90001C" Offset="1"/>
    </LinearGradientBrush>

    <!-- Frozen Laser Cyan -->
    <LinearGradientBrush x:Key="LbpCyan" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00F2FE" Offset="0"/>
        <GradientStop Color="#005A9E" Offset="1"/>
    </LinearGradientBrush>

    <!-- Vivid Northern Emerald -->
    <LinearGradientBrush x:Key="LbpEmerald" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FF87" Offset="0"/>
        <GradientStop Color="#006622" Offset="1"/>
    </LinearGradientBrush>

    <!-- ========================================================= -->
    <!-- 2. AURORA INTERACTIVE UI STYLES                           -->
    <!-- ========================================================= -->

    <!-- Laser Etched Popit Card with Glowing Corners -->
    <Style x:Key="PopitCard" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Margin="12">
                        <!-- Neon Rose Backlight Bloom -->
                        <Border CornerRadius="16" Background="#FF003C" Margin="2,6,-2,-6" Opacity="0.25">
                            <Border.Effect>
                                <BlurEffect Radius="18"/>
                            </Border.Effect>
                        </Border>

                        <!-- Outer Shell with dynamic Border Gradient -->
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="1" 
                                CornerRadius="16">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0055" Offset="0.0"/>
                                    <GradientStop Color="#3D000A" Offset="0.5"/>
                                    <GradientStop Color="#00FF87" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            
                            <Grid>
                                <!-- Internal Tech grid lines -->
                                <Border CornerRadius="15" Margin="1" Opacity="0.04">
                                    <Border.Background>
                                        <DrawingBrush Viewport="0,0,12,12" ViewportUnits="Absolute" TileMode="Tile">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="#FF0055">
                                                    <GeometryDrawing.Geometry>
                                                        <GeometryGroup>
                                                            <LineGeometry StartPoint="0,0" EndPoint="12,0"/>
                                                            <LineGeometry StartPoint="0,0" EndPoint="0,12"/>
                                                        </GeometryGroup>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.Background>
                                </Border>
                                
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>

                        <!-- Sharp Neon Tech Brackets in Corners -->
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0">
                            <Path Data="M 1,12 L 1,1 L 12,1" Stroke="#FF004C" StrokeThickness="2" Width="14" Height="14" Stretch="Fill">
                                <Path.Effect><BlurEffect Radius="2"/></Path.Effect>
                            </Path>
                            <Path Data="M 1,12 L 1,1 L 12,1" Stroke="#FAFAFA" StrokeThickness="1.5" Width="14" Height="14" Stretch="Fill"/>
                        </Grid>
                        
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                            <Path Data="M 11,12 L 11,1 L 0,1" Stroke="#FF004C" StrokeThickness="2" Width="14" Height="14" Stretch="Fill">
                                <Path.Effect><BlurEffect Radius="2"/></Path.Effect>
                            </Path>
                            <Path Data="M 11,12 L 11,1 L 0,1" Stroke="#FAFAFA" StrokeThickness="1.5" Width="14" Height="14" Stretch="Fill"/>
                        </Grid>
                        
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-4,0,0,-4">
                            <Path Data="M 1,0 L 1,11 L 12,11" Stroke="#FF004C" StrokeThickness="2" Width="14" Height="14" Stretch="Fill">
                                <Path.Effect><BlurEffect Radius="2"/></Path.Effect>
                            </Path>
                            <Path Data="M 1,0 L 1,11 L 12,11" Stroke="#FAFAFA" StrokeThickness="1.5" Width="14" Height="14" Stretch="Fill"/>
                        </Grid>
                        
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4">
                            <Path Data="M 11,0 L 11,11 L 0,11" Stroke="#FF004C" StrokeThickness="2" Width="14" Height="14" Stretch="Fill">
                                <Path.Effect><BlurEffect Radius="2"/></Path.Effect>
                            </Path>
                            <Path Data="M 11,0 L 11,11 L 0,11" Stroke="#FAFAFA" StrokeThickness="1.5" Width="14" Height="14" Stretch="Fill"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glossy Obsidian Bricks with Aurora Edge Highlights -->
    <Style x:Key="BubbleButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Aurora Under-Shadow -->
                        <Border x:Name="shadow" Background="#FF003C" CornerRadius="14" Margin="0,3,0,-3" Opacity="0.30">
                            <Border.Effect>
                                <BlurEffect Radius="8"/>
                            </Border.Effect>
                        </Border>

                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            
                            <Grid>
                                <!-- Gloss Highlights -->
                                <Border CornerRadius="13,13,4,4" Margin="1" Height="12" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#60FFFFFF" Offset="0"/>
                                            <GradientStop Color="#02FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1.5" Opacity="0.5" Color="Black" Direction="270"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bgBorder" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="shadow" Property="Margin" Value="0,4,0,-4"/>
                            <Setter TargetName="shadow" Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bgBorder" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="shadow" Property="Margin" Value="0,1,0,-1"/>
                            <Setter TargetName="shadow" Property="Opacity" Value="0.15"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>