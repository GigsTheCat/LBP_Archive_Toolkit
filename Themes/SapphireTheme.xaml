<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="AnimatedBgTemplate" TargetType="ContentControl">
        <Grid /> <!-- Left empty for basic static gradient fallback -->
    </ControlTemplate>

    <!-- ========================================================= -->
    <!-- 1. DETAILED SAPPHIRE & SPARKLE TEXTURES (PURE XAML)      -->
    <!-- ========================================================= -->

    <!-- Tiled Dark Sapphire Velvet Canvas with Elegant Star Sparkles -->
    <DrawingBrush x:Key="BgPrimary" Viewport="0,0,120,120" ViewportUnits="Absolute" TileMode="Tile">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Deep Royal Sapphire to Midnight Blue Base Gradient -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="1.0" RadiusY="1.0" GradientOrigin="0.5,0.5">
                            <GradientStop Color="#0F172A" Offset="0"/>
                            <GradientStop Color="#090D1A" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,120,120"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Sparkle 1: Delicate light-blue star (soft background shimmer) -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#38BDF8" Opacity="0.12"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 30,15 L 33,27 L 45,30 L 33,33 L 30,45 L 27,33 L 15,30 L 27,27 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Sparkle 2: Soft indigo star -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#818CF8" Opacity="0.10"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 90,75 L 92,83 L 100,85 L 92,87 L 90,95 L 88,87 L 80,85 L 88,83 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Sparkle 3: Tiny sharp white sparkle -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FFFFFF" Opacity="0.08"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 105,20 L 106,24 L 110,25 L 106,26 L 105,30 L 104,26 L 100,25 L 104,24 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Translucent Sapphire glass panels -->
    <SolidColorBrush x:Key="BgCard" Color="#1E293B" Opacity="0.95"/>
    <SolidColorBrush x:Key="BgCardDarker" Color="#0B0F19"/>

    <!-- Light color typography and subtle borders -->
    <SolidColorBrush x:Key="FgPrimary" Color="#F0F9FF"/>
    <SolidColorBrush x:Key="FgSecondary" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#1E3A8A"/>

    <!-- Polished Jewel Gradient Accents -->
    <!-- Gold / Amber Accent to pair beautifully with dark blue -->
    <LinearGradientBrush x:Key="LbpOrange" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FBBF24" Offset="0"/>
        <GradientStop Color="#D97706" Offset="1"/>
    </LinearGradientBrush>

    <!-- Deep Royal Magenta / Purple -->
    <LinearGradientBrush x:Key="LbpPink" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EC4899" Offset="0"/>
        <GradientStop Color="#A21CAF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Electric Cyan / Brilliant Sapphire Blue -->
    <LinearGradientBrush x:Key="LbpCyan" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38BDF8" Offset="0"/>
        <GradientStop Color="#0284C7" Offset="1"/>
    </LinearGradientBrush>

    <!-- High-Sheen Aqua / Emerald -->
    <LinearGradientBrush x:Key="LbpEmerald" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2DD4BF" Offset="0"/>
        <GradientStop Color="#0F766E" Offset="1"/>
    </LinearGradientBrush>

    <!-- ========================================================= -->
    <!-- 2. SAPPHIRE GLASS UI STYLES                               -->
    <!-- ========================================================= -->

    <!-- Elegant Sapphire Cut Popit Card Container -->
    <Style x:Key="PopitCard" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Margin="12">
                        <!-- Drop Shadow Bloom -->
                        <Border CornerRadius="16" Background="#000000" Margin="2,6,-2,-6" Opacity="0.5">
                            <Border.Effect>
                                <BlurEffect Radius="14"/>
                            </Border.Effect>
                        </Border>

                        <!-- Main Sapphire Body with Light Refraction Edge -->
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="1" 
                                CornerRadius="16">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0.0"/>
                                    <GradientStop Color="#60A5FA" Offset="0.5"/>
                                    <GradientStop Color="#1D4ED8" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            
                            <Grid>
                                <!-- Subtle Internal Diagonal Luster Highlight -->
                                <Border CornerRadius="15" Margin="1" Opacity="0.03">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="0.4"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>

                        <!-- Glowing Cut-Gem Crystal Pins in Corners -->
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0">
                            <Path Data="M 12,2 L 16,8 L 22,12 L 16,16 L 12,22 L 8,16 L 2,12 L 8,8 Z" Fill="#0284C7" Opacity="0.6" Width="20" Height="20" Stretch="Fill">
                                <Path.Effect><BlurEffect Radius="4"/></Path.Effect>
                            </Path>
                            <Path Data="M 12,2 L 15,9 L 22,12 L 15,15 L 12,22 L 9,15 L 2,12 L 9,9 Z" Fill="{DynamicResource LbpCyan}" Stroke="#E0F2FE" StrokeThickness="0.5" Width="20" Height="20" Stretch="Fill"/>
                        </Grid>
                        
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0">
                            <Path Data="M 12,2 L 16,8 L 22,12 L 16,16 L 12,22 L 8,16 L 2,12 L 8,8 Z" Fill="#0284C7" Opacity="0.6" Width="20" Height="20" Stretch="Fill">
                                <Path.Effect><BlurEffect Radius="4"/></Path.Effect>
                            </Path>
                            <Path Data="M 12,2 L 15,9 L 22,12 L 15,15 L 12,22 L 9,15 L 2,12 L 9,9 Z" Fill="{DynamicResource LbpCyan}" Stroke="#E0F2FE" StrokeThickness="0.5" Width="20" Height="20" Stretch="Fill"/>
                        </Grid>
                        
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6,0,0,-6">
                            <Path Data="M 12,2 L 16,8 L 22,12 L 16,16 L 12,22 L 8,16 L 2,12 L 8,8 Z" Fill="#0284C7" Opacity="0.6" Width="20" Height="20" Stretch="Fill">
                                <Path.Effect><BlurEffect Radius="4"/></Path.Effect>
                            </Path>
                            <Path Data="M 12,2 L 15,9 L 22,12 L 15,15 L 12,22 L 9,15 L 2,12 L 9,9 Z" Fill="{DynamicResource LbpCyan}" Stroke="#E0F2FE" StrokeThickness="0.5" Width="20" Height="20" Stretch="Fill"/>
                        </Grid>
                        
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6">
                            <Path Data="M 12,2 L 16,8 L 22,12 L 16,16 L 12,22 L 8,16 L 2,12 L 8,8 Z" Fill="#0284C7" Opacity="0.6" Width="20" Height="20" Stretch="Fill">
                                <Path.Effect><BlurEffect Radius="4"/></Path.Effect>
                            </Path>
                            <Path Data="M 12,2 L 15,9 L 22,12 L 15,15 L 12,22 L 9,15 L 2,12 L 9,9 Z" Fill="{DynamicResource LbpCyan}" Stroke="#E0F2FE" StrokeThickness="0.5" Width="20" Height="20" Stretch="Fill"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glossy 3D Glass Bubble Buttons -->
    <Style x:Key="BubbleButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Soft Ambient Glow Shadow -->
                        <Border x:Name="shadow" Background="#0284C7" CornerRadius="16" Margin="0,3,0,-3" Opacity="0.15">
                            <Border.Effect>
                                <BlurEffect Radius="8"/>
                            </Border.Effect>
                        </Border>

                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            
                            <Grid>
                                <!-- Clear Gloss Refraction Cap -->
                                <Border CornerRadius="15,15,4,4" Margin="1" Height="14" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#70FFFFFF" Offset="0"/>
                                            <GradientStop Color="#05FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.5" Color="Black" Direction="270"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bgBorder" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="shadow" Property="Margin" Value="0,5,0,-5"/>
                            <Setter TargetName="shadow" Property="Opacity" Value="0.3"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bgBorder" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="shadow" Property="Margin" Value="0,1,0,-1"/>
                            <Setter TargetName="shadow" Property="Opacity" Value="0.1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>