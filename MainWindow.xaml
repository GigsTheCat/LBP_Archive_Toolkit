<Window x:Class="LbpArchiveToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LBP Archive Toolkit" 
        Height="960" Width="1520" 
        MinHeight="720" MinWidth="1250"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        WindowStyle="None" BorderThickness="0"
        AllowsTransparency="True" Background="Transparent">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" CornerRadius="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        
        <!-- BASE BUTTON STYLES -->
        
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="#453868"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#574880"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnNav" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="#453868"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5C4B8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSearch" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpOrange}"/>
            <Setter Property="Foreground" Value="#4A2600"/> 
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC83D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnActionBlue" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpCyan}"/>
            <Setter Property="Foreground" Value="#002D3D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7EE0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnExtract" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpEmerald}"/>
            <Setter Property="Foreground" Value="#003D2A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#38E8B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{DynamicResource BgCardDarker}" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource LbpCyan}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="#3D325C"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="#453868"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton" Template="{StaticResource ComboBoxToggleButton}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Focusable="false"/>
                            <ContentPresenter x:Name="contentPresenter" IsHitTestVisible="False" Margin="12,0,30,0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource LbpPink}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, ElementName=toggleButton}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="2,4,2,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#453868"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LbpPink}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DataGridTextCenterStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="DisplayTagStyle" TargetType="ContentControl">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="1,1,2,2"/>
            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="#3D325C" 
                                BorderBrush="{DynamicResource BorderSubtle}" 
                                BorderThickness="1" 
                                CornerRadius="6"
                                Margin="{TemplateBinding Margin}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.4" Direction="315" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgPrimary}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                <Setter Property="Padding" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <ContentControl Template="{DynamicResource AnimatedBgTemplate}" IsHitTestVisible="False"/>

            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="32" Background="Transparent">
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="─" Style="{StaticResource TitleBarBtn}" Click="TitleBar_Minimize_Click"/>
                        <Button Content="◻" Style="{StaticResource TitleBarBtn}" Click="TitleBar_Maximize_Click"/>
                        <Button Content="✕" Style="{StaticResource TitleBarCloseBtn}" Click="TitleBar_Close_Click"/>
                    </StackPanel>
                </Grid>

                <Menu DockPanel.Dock="Top" Background="Transparent" Padding="10,4">
                    <MenuItem Header="Options">
                        <MenuItem Header="Settings..." Command="{Binding OpenSettingsCommand}"/>
                    </MenuItem>
                    <MenuItem Header="Lists">
                        <MenuItem Header="Backup Manager..." Command="{Binding OpenBackupManagerCommand}"/>
                        <MenuItem Header="Hearted Levels..." Command="{Binding OpenHeartedLevelsCommand}"/>
                        <MenuItem Header="Hearted Creators..." Command="{Binding OpenHeartedCreatorsCommand}"/>
                    </MenuItem>
                    <MenuItem Header="Info">
                        <MenuItem Header="Downloads..." Command="{Binding OpenDownloadsCommand}"/>
                        <MenuItem Header="Log Viewer" Command="{Binding OpenLogViewerCommand}"/>
                        <MenuItem Header="About" Command="{Binding OpenAboutCommand}"/>
                    </MenuItem>
                </Menu>

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> 
                        <RowDefinition Height="*"/>    
                        <RowDefinition Height="Auto"/> 
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>     
                        <ColumnDefinition Width="15"/>    
                        <ColumnDefinition Width="340"/>   
                    </Grid.ColumnDefinitions>

                    <ContentControl Grid.Row="0" Grid.Column="0" Style="{DynamicResource PopitCard}" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,15">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,15,0">
                                    <Button x:Name="btnBack" Content="←" Width="40" Height="40" Margin="0,0,8,0" FontSize="18" Style="{DynamicResource BtnNav}" Command="{Binding BackCommand}"/>
                                    <Button x:Name="btnForward" Content="→" Width="40" Height="40" FontSize="18" Style="{DynamicResource BtnNav}" Command="{Binding ForwardCommand}"/>
                                </StackPanel>
                                
                                <Button x:Name="btnCancelSearch" Content="CANCEL" DockPanel.Dock="Right" Width="160" Height="40" Margin="15,0,0,0" FontSize="14" Style="{DynamicResource BtnSecondary}" Visibility="{Binding CancelButtonVisibility}" Command="{Binding CancelSearchCommand}"/>
                                <Button x:Name="btnSearch" Content="SEARCH" DockPanel.Dock="Right" Width="110" Height="40" Margin="10,0,0,0" FontSize="14" Style="{DynamicResource BtnSearch}" Visibility="{Binding SearchButtonVisibility}" Command="{Binding SearchCommand}"/>
                                <Button x:Name="btnSurprise" Content="🎲" DockPanel.Dock="Right" Width="40" Height="40" Margin="15,0,0,0" Padding="0" FontSize="20" Style="{DynamicResource BtnSecondary}" ToolTip="Surprise Me! (Random)" Visibility="{Binding SurpriseButtonVisibility}" Command="{Binding SurpriseMeCommand}"/>
                                
                                <Border Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource LbpPink}" BorderThickness="2" CornerRadius="20" Padding="15,0">
                                    <TextBox x:Name="txtSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource FgPrimary}" BorderThickness="0" VerticalContentAlignment="Center" FontSize="15">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                        </TextBox.InputBindings>
                                        <TextBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Command="Cut" Header="Cut" />
                                                <MenuItem Command="Copy" Header="Copy" />
                                                <MenuItem Command="Paste" Header="Paste" />
                                            </ContextMenu>
                                        </TextBox.ContextMenu>
                                    </TextBox>
                                </Border>
                            </DockPanel>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Search Type:" Foreground="{DynamicResource LbpCyan}" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbSearchType" SelectedIndex="{Binding SearchTypeIndex}" Width="125" Margin="0,0,8,5">
                                    <ComboBoxItem Content="Levels"/>
                                    <ComboBoxItem Content="Creators"/>
                                    <ComboBoxItem x:Name="cbiContributions" Content="Contributions" Visibility="{Binding HasContributorsVisibility}"/>
                                    <ComboBoxItem x:Name="cbiObjects" Content="Objects By" Visibility="{Binding HasObjectContributorsVisibility}"/>
                                </ComboBox>

                                <StackPanel x:Name="panelLevelFilters" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding LevelViewVisibility}">
                                    <TextBlock Text="Game:" Foreground="{DynamicResource LbpCyan}" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbGame" SelectedIndex="{Binding GameIndex}" Width="110" Margin="0,0,8,5">
                                        <ComboBoxItem Content="All Games"/>
                                        <ComboBoxItem Content="LBP 1"/>
                                        <ComboBoxItem Content="LBP 2"/>
                                        <ComboBoxItem Content="LBP 3"/>
                                    </ComboBox>

                                    <TextBlock Text="Genre:" Foreground="{DynamicResource LbpCyan}" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbGenre" ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}" Width="150" Margin="0,0,8,5" />
                                </StackPanel>

                                <TextBlock Text="Limit:" Foreground="{DynamicResource LbpCyan}" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbLimit" SelectedIndex="{Binding LimitIndex}" Width="75" Margin="0,0,15,5">
                                    <ComboBoxItem Content="100"/>
                                    <ComboBoxItem Content="200"/>
                                    <ComboBoxItem Content="500"/>
                                    <ComboBoxItem Content="1000"/>
                                    <ComboBoxItem Content="All"/>
                                </ComboBox>

                                <CheckBox x:Name="chkExact" Content="Exact Phrase" IsChecked="{Binding ExactMatch}" Margin="0,0,15,5"/>
                                <CheckBox x:Name="chkSearchDesc" Content="Search Descriptions" IsChecked="{Binding SearchDesc}" Margin="0,0,15,5" Visibility="{Binding SearchDescVisibility}"/>
                                <Button x:Name="btnAdvanced" Content="ADVANCED ⚙" Style="{DynamicResource BtnSecondary}" Padding="12,4" Margin="0,0,0,5" FontSize="11" Visibility="{Binding AdvancedButtonVisibility}" Command="{Binding OpenAdvancedSearchCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Grid.Row="1" Grid.Column="0" Style="{DynamicResource PopitCard}" Padding="5">
                        <Grid>
                            <DataGrid x:Name="dgResults" ItemsSource="{Binding ResultsList}" SelectedItem="{Binding SelectedLevel}"
                                      Visibility="{Binding LevelViewVisibility}" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#15FFFFFF" 
                                      Foreground="{DynamicResource FgPrimary}" BorderThickness="0" GridLinesVisibility="None" 
                                      HeadersVisibility="Column" AutoGenerateColumns="False" RowHeight="32" IsReadOnly="True">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SAVED" Width="70" Binding="{Binding Saved}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                    <DataGridTextColumn Header="GAME" Width="80" Binding="{Binding Game}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                    <DataGridTextColumn Header="PUBLISHED" Width="120" Binding="{Binding Date}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                    <DataGridTemplateColumn Header="CREATOR" Width="140" SortMemberPath="Creator">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Creator}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource LbpCyan}" FontWeight="SemiBold" TextAlignment="Left" VerticalAlignment="Center" Padding="8,0">
                                                    <TextBlock.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Search Creator" Command="{Binding PlacementTarget.Tag.SearchCreatorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                            <MenuItem x:Name="MenuSearchContributions" Header="Search Contributions" Command="{Binding PlacementTarget.Tag.ViewUserContributionsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                            <MenuItem x:Name="MenuSearchObjects" Header="Search Objects By" Command="{Binding PlacementTarget.Tag.ViewUserObjectsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                            <MenuItem x:Name="MenuHeartCreator" Header="Heart Creator" Command="{Binding PlacementTarget.Tag.HeartUserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </TextBlock.ContextMenu>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="LEVEL NAME" Width="*" SortMemberPath="LevelName">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LevelName}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource DataGridTextCenterStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Copy Level Name" Command="{Binding PlacementTarget.Tag.CopyLevelNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </TextBlock.ContextMenu>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="PLAYS" Width="80" Binding="{Binding Plays}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                    <DataGridTextColumn x:Name="colClears" Header="CLEARS" Width="80" Binding="{Binding Clears}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                    <DataGridTextColumn Header="♥" Width="60" Binding="{Binding Hearts}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCenterStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource LbpPink}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="GENRE" Width="110" Binding="{Binding Genre}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid x:Name="dgUsers" ItemsSource="{Binding UserResultsList}" SelectedItem="{Binding SelectedUser}"
                                      Visibility="{Binding UserViewVisibility}" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#15FFFFFF" 
                                      Foreground="{DynamicResource FgPrimary}" BorderThickness="0" GridLinesVisibility="None" 
                                      HeadersVisibility="Column" AutoGenerateColumns="False" RowHeight="32" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CREATOR" Width="*" Binding="{Binding NpHandle}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                    <DataGridTextColumn Header="TOTAL LEVELS" Width="130" Binding="{Binding TotalLevels}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                    <DataGridTextColumn Header="LBP1" Width="90" Binding="{Binding Lbp1UsedSlots}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                    <DataGridTextColumn Header="LBP2" Width="90" Binding="{Binding Lbp2UsedSlots}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                    <DataGridTextColumn Header="LBP3" Width="90" Binding="{Binding Lbp3UsedSlots}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                    <DataGridTextColumn Header="♥" Width="100" Binding="{Binding HeartCount}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCenterStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource LbpPink}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </ContentControl>

                    <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderSubtle}" Cursor="SizeWE" Margin="0,20"/>

                    <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">
                        <!-- Level Details -->
                        <ContentControl x:Name="panelLevelDetails" Style="{DynamicResource PopitCard}" Padding="20" Visibility="{Binding LevelViewVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="*"/>    
                                    <RowDefinition Height="Auto"/> 
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Width="180" Height="180" Margin="0,0,0,15">
                                    <Ellipse Fill="Black" Opacity="0.3" Margin="-3" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><TranslateTransform Y="8"/></Ellipse.RenderTransform>
                                        <Ellipse.Effect><BlurEffect Radius="12"/></Ellipse.Effect>
                                    </Ellipse>
                                    
                                    <Path x:Name="mmPickTails" Visibility="{Binding MmPickVisibility}" Data="M 90,140 L 40,240 L 75,220 L 90,190 L 105,220 L 140,240 Z" Fill="{DynamicResource LbpPink}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-45">
                                        <Path.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/></Path.Effect>
                                    </Path>
                                    <Ellipse x:Name="mmPickRosette" Visibility="{Binding MmPickVisibility}" Margin="-12" Stroke="{DynamicResource LbpPink}" StrokeThickness="16" StrokeDashArray="2 1.5" StrokeDashCap="Flat" />
                                    <Ellipse x:Name="mmPickRosetteInner" Visibility="{Binding MmPickVisibility}" Margin="-4" Stroke="#B80E5B" StrokeThickness="4" />

                                    <Ellipse x:Name="iconEllipse" Stroke="{Binding IconEllipseStroke}" StrokeThickness="5" Fill="{Binding IconEllipseFill}">
                                        <Ellipse.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy Image" Command="{Binding CopyImageCommand}" CommandParameter="{Binding IconEllipseFill}" />
                                                <MenuItem Header="Save Image..." Command="{Binding SaveImageCommand}" CommandParameter="{Binding IconEllipseFill}" />
                                            </ContextMenu>
                                        </Ellipse.ContextMenu>
                                    </Ellipse>
                                    <TextBlock x:Name="txtIconStatus" Text="{Binding IconStatusText}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                                    <TextBlock x:Name="iconHeartOverlay" Text="♥" Visibility="{Binding LevelHeartOverlayVisibility}" Foreground="{DynamicResource LbpPink}" FontSize="60" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-10,0,0,-15">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="4" Opacity="0.6" Color="Black" Direction="270"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                    <TextBlock Tag="{Binding}" Text="{Binding SelectedLevel.LevelName}" Foreground="{DynamicResource FgPrimary}" FontWeight="Black" FontSize="18" TextWrapping="Wrap" TextAlignment="Center">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy Level Name" Command="{Binding PlacementTarget.Tag.CopyLevelNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedLevel, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                    <TextBlock Tag="{Binding}" Text="{Binding LevelCreatorAndStatsText}" Foreground="{DynamicResource LbpCyan}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Search Creator" Command="{Binding PlacementTarget.Tag.SearchCreatorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedLevel, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem x:Name="MenuSearchContributions" Header="Search Contributions" Command="{Binding PlacementTarget.Tag.ViewUserContributionsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedLevel, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem x:Name="MenuSearchObjects" Header="Search Objects By" Command="{Binding PlacementTarget.Tag.ViewUserObjectsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedLevel, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem x:Name="MenuHeartCreator" Header="Heart Creator" Command="{Binding PlacementTarget.Tag.HeartUserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedLevel, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                                    <Button x:Name="btnToggleTags" Content="{Binding ToggleTagsButtonText}" Command="{Binding ToggleTagsCommand}" Visibility="{Binding ToggleTagsButtonVisibility}" Style="{DynamicResource BtnSecondary}" Padding="10,4" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding LevelTags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding Text}" Visibility="{Binding Visibility}" Style="{DynamicResource DisplayTagStyle}">
                                                    <ContentControl.LayoutTransform>
                                                        <RotateTransform Angle="{Binding TiltAngle}"/>
                                                    </ContentControl.LayoutTransform>
                                                </ContentControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <DockPanel Grid.Row="3" Margin="0,0,0,15">
                                    <TextBlock DockPanel.Dock="Top" Text="DESCRIPTION" Foreground="{DynamicResource LbpPink}" FontWeight="Black" FontSize="12" Margin="0,0,0,6"/>
                                    <Border Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="2" CornerRadius="12" Padding="12">
                                        <RichTextBox x:Name="txtDescription" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource FgPrimary}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="14">
                                            <RichTextBox.CommandBindings>
                                                <CommandBinding Command="Copy" CanExecute="TxtDescription_Copy_CanExecute" Executed="TxtDescription_Copy_Executed" />
                                            </RichTextBox.CommandBindings>
                                            <RichTextBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Command="Copy" Header="Copy" />
                                                </ContextMenu>
                                            </RichTextBox.ContextMenu>
                                        </RichTextBox>
                                    </Border>
                                </DockPanel>

                                <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                                    <Button Content="{Binding HeartLevelButtonText}" Command="{Binding HeartLevelCommand}" Margin="0,0,0,6" Padding="12,6" FontSize="12" Style="{DynamicResource BtnSecondary}" />
                                    <Button x:Name="btnCopyHash" Content="COPY HASH" Command="{Binding CopyHashCommand}" Margin="0,0,0,6" Padding="12,6" FontSize="12" Style="{DynamicResource BtnActionBlue}" />
                                    <Button Content="CONTRIBUTORS" Command="{Binding ShowContributorsCommand}" Margin="0,0,0,6" Padding="12,6" FontSize="12" Style="{DynamicResource BtnActionBlue}" />
                                    <Button x:Name="btnExtract" Content="EXTRACT &amp; BACKUP" Command="{Binding ExtractSelectedCommand}" CommandParameter="{Binding SelectedItems, ElementName=dgResults}" Style="{DynamicResource BtnExtract}" />
                                </StackPanel>
                            </Grid>
                        </ContentControl>

                        <!-- User Details -->
                        <ContentControl x:Name="panelUserDetails" Style="{DynamicResource PopitCard}" Padding="20" Visibility="{Binding UserViewVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="*"/>    
                                    <RowDefinition Height="Auto"/> 
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Width="180" Height="180" Margin="0,0,0,15">
                                    <Rectangle Fill="Black" Opacity="0.3" Margin="-3" RenderTransformOrigin="0.5,0.5" RadiusX="8" RadiusY="8">
                                        <Rectangle.RenderTransform><TranslateTransform Y="8"/></Rectangle.RenderTransform>
                                        <Rectangle.Effect><BlurEffect Radius="12"/></Rectangle.Effect>
                                    </Rectangle>
                                    <Rectangle x:Name="userIconRect" Stroke="{DynamicResource LbpOrange}" StrokeThickness="5" Fill="{Binding UserIconRectFill}" RadiusX="8" RadiusY="8">
                                        <Rectangle.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy Image" Command="{Binding CopyImageCommand}" CommandParameter="{Binding UserIconRectFill}" />
                                                <MenuItem Header="Save Image..." Command="{Binding SaveImageCommand}" CommandParameter="{Binding UserIconRectFill}" />
                                            </ContextMenu>
                                        </Rectangle.ContextMenu>
                                    </Rectangle>
                                    <TextBlock x:Name="txtUserIconStatus" Text="{Binding UserIconStatusText}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    
                                    <TextBlock x:Name="userIconHeartOverlay" Text="♥" Visibility="{Binding UserHeartOverlayVisibility}" Foreground="{DynamicResource LbpPink}" FontSize="60" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-10,0,0,-15">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="4" Opacity="0.6" Color="Black" Direction="270"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding SelectedUser.NpHandle}" Foreground="{DynamicResource FgPrimary}" FontWeight="Black" FontSize="20" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding UserStatsText}" Foreground="{DynamicResource LbpCyan}" FontWeight="SemiBold" FontSize="13" Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>

                                <DockPanel Grid.Row="2" Margin="0,0,0,15">
                                    <TextBlock DockPanel.Dock="Top" Text="CREATOR SUMMARY" Foreground="{DynamicResource LbpPink}" FontWeight="Black" FontSize="12" Margin="0,0,0,6"/>
                                    <Border Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="2" CornerRadius="12" Padding="12">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding UserSummaryText}" Foreground="{DynamicResource FgPrimary}" FontSize="14" TextWrapping="Wrap" LineHeight="20"/>
                                        </ScrollViewer>
                                    </Border>
                                </DockPanel>

                                <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                                    <Button Content="{Binding UserHeartButtonText}" Command="{Binding HeartUserCommand}" Margin="0,0,0,6" Padding="12,6" FontSize="12" Style="{DynamicResource BtnSecondary}" />
                                    <Button Content="VIEW CREATOR'S LEVELS" Command="{Binding ViewUserLevelsCommand}" Margin="0,0,0,6" Padding="12,6" FontSize="12" Style="{DynamicResource BtnActionBlue}" />
                                    <Button Content="VIEW CONTRIBUTIONS" Command="{Binding ViewUserContributionsCommand}" Visibility="{Binding HasContributorsVisibility}" Margin="0,0,0,6" Padding="12,6" FontSize="12" Style="{DynamicResource BtnActionBlue}" />
                                    <Button Content="VIEW OBJECTS BY" Command="{Binding ViewUserObjectsCommand}" Visibility="{Binding HasObjectContributorsVisibility}" Margin="0,0,0,6" Padding="12,6" FontSize="12" Style="{DynamicResource BtnActionBlue}" />
                                    <Button x:Name="btnBatchDownload" Content="DOWNLOAD ALL LEVELS" Command="{Binding BatchDownloadCommand}" Style="{DynamicResource BtnExtract}" />
                                </StackPanel>
                            </Grid>
                        </ContentControl>
                    </Grid>

                    <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15,0,5">
                        <Border DockPanel.Dock="Right" Width="220" Height="14" Background="{DynamicResource BgCardDarker}" CornerRadius="7" ClipToBounds="True" Visibility="{Binding IsProgressVisible}">
                            <ProgressBar Background="Transparent" Foreground="{DynamicResource LbpEmerald}" BorderThickness="0" IsIndeterminate="{Binding IsProgressIndeterminate}" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}"/>
                        </Border>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </DockPanel>
            
            <Popup x:Name="notificationToastPopup" AllowsTransparency="True" Placement="Top" HorizontalOffset="0" VerticalOffset="-8" IsHitTestVisible="False">
                <Border x:Name="notificationToastBorder" Background="{DynamicResource LbpEmerald}" Padding="16,10" CornerRadius="16" Opacity="0" Margin="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.5" Direction="270" Color="Black"/>
                    </Border.Effect>
                    <TextBlock x:Name="txtNotification" Text="Copied!" Foreground="#003D2A" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>