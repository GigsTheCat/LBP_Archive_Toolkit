<Window x:Class="LbpArchiveToolkit.BackupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Manager" Height="850" Width="1300"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" WindowStyle="None" BorderThickness="0"
        AllowsTransparency="True" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" CornerRadius="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#19132B"/> 
        <SolidColorBrush x:Key="BgCard" Color="#2D2447"/>
        <SolidColorBrush x:Key="BgCardDarker" Color="#221A35"/>
        <SolidColorBrush x:Key="FgPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="FgSecondary" Color="#B7AEDB"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#453868"/>
        <SolidColorBrush x:Key="LbpOrange" Color="#FFB703"/>
        <SolidColorBrush x:Key="LbpPink" Color="#F72585"/>
        <SolidColorBrush x:Key="LbpCyan" Color="#4CC9F0"/>
        <SolidColorBrush x:Key="LbpEmerald" Color="#06D6A0"/>

        <!-- ============================================== -->
        <!-- SCROLLBAR THEME                                -->
        <!-- ============================================== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder" Background="{StaticResource BorderSubtle}" CornerRadius="4" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource LbpPink}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource LbpCyan}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="thumbBorder" Background="{StaticResource BorderSubtle}" CornerRadius="4" Margin="0,2"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource LbpPink}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource LbpCyan}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource FgSecondary}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D325C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="0,14,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter TargetName="bg" Property="CornerRadius" Value="0"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopitCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3" Direction="270" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BubbleButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="20"> 
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3D325C"/>
                                <Setter Property="Foreground" Value="#6A5C8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDelete" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{StaticResource LbpPink}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A9F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridTextCenterStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </Window.Resources>

    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#130F25" Offset="0.0" />
                <GradientStop Color="#2A2045" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                <Setter Property="Padding" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,8,8,16"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="32" Background="Transparent">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="─" Style="{StaticResource TitleBarBtn}" Click="TitleBar_Minimize_Click"/>
                    <Button Content="◻" Style="{StaticResource TitleBarBtn}" Click="TitleBar_Maximize_Click"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseBtn}" Click="TitleBar_Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Margin="20,20,20,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="LOCAL BACKUPS" Foreground="{StaticResource LbpOrange}" FontSize="20" FontWeight="Black" Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="380"/> 
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PopitCard}" Padding="5">
                        <DataGrid x:Name="lvBackups" 
                                  Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#15FFFFFF" 
                                  Foreground="{StaticResource FgPrimary}" BorderThickness="0" GridLinesVisibility="None" 
                                  HeadersVisibility="Column" AutoGenerateColumns="False" RowHeight="32" IsReadOnly="True"
                                  SelectionChanged="LvBackups_SelectionChanged">
                            
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#F72585"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#701A44"/>
                            </DataGrid.Resources>

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource LbpOrange}"/>
                                    <Setter Property="FontWeight" Value="Black"/>
                                    <Setter Property="Padding" Value="8,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LEVEL &amp; CREATOR ↕" Width="*" Binding="{Binding LevelName}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                <DataGridTextColumn Header="FOLDER ID ↕" Width="200" Binding="{Binding FolderName}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                                <DataGridTextColumn Header="DATE BACKED UP ↕" Width="180" Binding="{Binding DateSaved}" ElementStyle="{StaticResource DataGridTextCenterStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#453868" Cursor="SizeWE" Margin="0,20"/>

                    <Border Grid.Column="2" Style="{StaticResource PopitCard}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> 
                                <RowDefinition Height="Auto"/> 
                                <RowDefinition Height="*"/>    
                                <RowDefinition Height="Auto"/> 
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Width="180" Height="180" Margin="0,0,0,15">
                                <Ellipse Fill="Black" Opacity="0.3" Margin="-3" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><TranslateTransform Y="8"/></Ellipse.RenderTransform>
                                    <Ellipse.Effect><BlurEffect Radius="12"/></Ellipse.Effect>
                                </Ellipse>
                                <Ellipse x:Name="iconEllipse" Stroke="{StaticResource LbpOrange}" StrokeThickness="5" Fill="{StaticResource BgPrimary}"/>
                                <TextBlock x:Name="txtIconStatus" Text="Select a backup&#x0a;to view details" Foreground="{StaticResource FgSecondary}" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>

                            <TextBlock x:Name="txtLevelTitle" Grid.Row="1" Text="" Foreground="{StaticResource FgPrimary}" FontWeight="Black" FontSize="20" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"/>

                            <DockPanel Grid.Row="2" Margin="0,0,0,20">
                                <TextBlock DockPanel.Dock="Top" Text="DESCRIPTION" Foreground="{StaticResource LbpCyan}" FontWeight="Black" FontSize="12" Margin="0,0,0,6"/>
                                <Border Background="{StaticResource BgCardDarker}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="2" CornerRadius="12" Padding="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="txtDescription" Foreground="{StaticResource FgPrimary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>

                            <StackPanel Grid.Row="3">
                                <TextBlock x:Name="txtStatus" Text="Ready." Foreground="{StaticResource FgSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <Button x:Name="btnDelete" Content="DELETE SELECTED BACKUP" IsEnabled="False" Style="{StaticResource BtnDelete}" Click="BtnDelete_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>