<Window x:Class="LbpArchiveToolkit.BackupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:LbpArchiveToolkit.Utils"
        Title="Backup Manager" Height="850" Width="1300"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" WindowStyle="None" BorderThickness="0"
        AllowsTransparency="True" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" CornerRadius="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>        
        <Style x:Key="BtnDelete" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpPink}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A9F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnActionBlue" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpCyan}"/>
            <Setter Property="Foreground" Value="#002D3D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7EE0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="#453868"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#574880"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgPrimary}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                <Setter Property="Padding" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,8,8,16"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
      
        <Grid>
            <ContentControl Template="{DynamicResource AnimatedBgTemplate}" IsHitTestVisible="False"/>

            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="32" Background="Transparent">
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="─" Style="{DynamicResource TitleBarBtn}" Click="TitleBar_Minimize_Click"/>
                        <Button Content="◻" Style="{DynamicResource TitleBarBtn}" Click="TitleBar_Maximize_Click"/>
                        <Button Content="✕" Style="{DynamicResource TitleBarCloseBtn}" Click="TitleBar_Close_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="20,20,20,25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="LOCAL BACKUPS" Foreground="{DynamicResource LbpOrange}" FontSize="20" FontWeight="Black" Margin="0,0,0,15"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="380"/> 
                        </Grid.ColumnDefinitions>

                        <ContentControl Grid.Column="0" Style="{DynamicResource PopitCard}" Padding="5">
                            <DataGrid x:Name="lvBackups" 
                                      ItemsSource="{Binding BackupList}" SelectedItem="{Binding SelectedBackup}"
                                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#15FFFFFF" 
                                      Foreground="{DynamicResource FgPrimary}" BorderThickness="0" GridLinesVisibility="None" 
                                      HeadersVisibility="Column" AutoGenerateColumns="False" RowHeight="32" IsReadOnly="True">
                                
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="LEVEL NAME" Width="*" Binding="{Binding LevelName}" ElementStyle="{DynamicResource DataGridTextCenterStyle}"/>
                                    <DataGridTextColumn Header="GAME" Width="100" Binding="{Binding Game}" ElementStyle="{DynamicResource DataGridTextCenterStyle}"/>
                                    <DataGridTextColumn Header="DATE BACKED UP" Width="180" Binding="{Binding DateSaved}" ElementStyle="{DynamicResource DataGridTextCenterStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ContentControl>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderSubtle}" Cursor="SizeWE" Margin="0,20"/>

                        <ContentControl Grid.Column="2" Style="{DynamicResource PopitCard}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="*"/>    
                                    <RowDefinition Height="Auto"/> 
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Width="180" Height="180" Margin="0,0,0,15">
                                    <Ellipse Fill="Black" Opacity="0.3" Margin="-3" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><TranslateTransform Y="8"/></Ellipse.RenderTransform>
                                        <Ellipse.Effect><BlurEffect Radius="12"/></Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="iconEllipse" Stroke="{DynamicResource LbpOrange}" StrokeThickness="5" Fill="{Binding IconFill}" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding IconScale}" ScaleY="{Binding IconScale}"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy Image" Command="{Binding CopyImageCommand}" CommandParameter="{Binding OriginalIconFill}" />
                                                <MenuItem Header="Save Image..." Command="{Binding SaveImageCommand}" CommandParameter="{Binding OriginalIconFill}" />
                                            </ContextMenu>
                                        </Ellipse.ContextMenu>
                                    </Ellipse>
                                    
                                    <Path x:Name="lockSymbol" Visibility="{Binding IconLockVisibility}" Data="M9 11V7c0-2.76 2.24-5 5-5s5 2.24 5 5v4h1a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2H8a2 2 0 0 1 -2 -2V13a2 2 0 0 1 2 -2h1zm2 0h6V7a3 3 0 0 0 -6 0v4z" Fill="{DynamicResource FgPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Stretch="Uniform" Width="64" Height="80">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="1.0" Color="Black" Direction="270"/>
                                        </Path.Effect>
                                    </Path>

                                    <TextBlock x:Name="txtIconStatus" Text="{Binding IconStatusText}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding LevelTitle}" utils:CreatorPreviewBehavior.CreatorName="{Binding SelectedBackup.Creator}" Foreground="{DynamicResource FgPrimary}" FontWeight="Black" FontSize="20" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"/>

                                <DockPanel Grid.Row="2" Margin="0,0,0,20">
                                    <TextBlock DockPanel.Dock="Top" Text="DESCRIPTION" Foreground="{DynamicResource LbpCyan}" FontWeight="Black" FontSize="12" Margin="0,0,0,6"/>
                                    <Border Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="2" CornerRadius="12" Padding="12">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding LevelDescription}" Foreground="{DynamicResource FgPrimary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Border>
                                </DockPanel>

                                <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                                    <Grid Margin="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/> <!-- Spacing gap -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Button Grid.Row="0" Grid.Column="0" Content="VIEW ASSETS" Style="{DynamicResource BtnActionBlue}" FontSize="11"
                                                Command="{Binding ViewTexturesCommand}" CommandParameter="{Binding SelectedItems, ElementName=lvBackups}"/>
                                        
                                        <Button Grid.Row="0" Grid.Column="2" Content="EDIT INFO" Style="{DynamicResource BtnActionBlue}" FontSize="11"
                                                Command="{Binding EditCommand}" CommandParameter="{Binding SelectedItems, ElementName=lvBackups}"/>
                                        
                                        <Button Grid.Row="2" Grid.Column="0" Content="MOVE" Style="{DynamicResource BtnActionBlue}" FontSize="11"
                                                Command="{Binding MoveCommand}" CommandParameter="{Binding SelectedItems, ElementName=lvBackups}"/>
                                        
                                        <Button Grid.Row="2" Grid.Column="2" Content="DELETE" Style="{DynamicResource BtnDelete}" FontSize="11"
                                                Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItems, ElementName=lvBackups}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ContentControl>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,15,0,5">
                        <Button Content="CHANGE FOLDER..." DockPanel.Dock="Right" Style="{DynamicResource BtnSecondary}" Padding="15,6" FontSize="11" Command="{Binding ChangeDirCommand}"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>