<Window x:Class="LbpArchiveToolkit.EditInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Level Info" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Segoe UI" Topmost="False">

    <Window.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpCyan}"/>
            <Setter Property="Foreground" Value="#002D3D"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7EE0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpPink}"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A9F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnActionBlue" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpCyan}"/>
            <Setter Property="Foreground" Value="#002D3D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7EE0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ContentControl Style="{DynamicResource PopitCard}" Margin="25" Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="EDIT LEVEL INFO" Foreground="{DynamicResource LbpOrange}" FontSize="22" FontWeight="Black" Margin="0,0,0,12"/>
            <Rectangle Grid.Row="1" Fill="{DynamicResource BorderSubtle}" Height="2" RadiusX="1" RadiusY="1" Margin="0,0,0,20"/>

            <DockPanel Grid.Row="2" Margin="0,0,0,20">
                <Border DockPanel.Dock="Left" Width="100" Height="55" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="2" CornerRadius="6" Margin="0,0,15,0" ClipToBounds="True" Background="{DynamicResource BgCardDarker}">
                    <!-- Direct Binding to IconImage via ViewModel -->
                    <Image Source="{Binding IconImage}" Stretch="UniformToFill"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LEVEL ICON" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Button Content="CHANGE ICON..." Command="{Binding ChangeIconCommand}" Style="{DynamicResource BtnActionBlue}" HorizontalAlignment="Left" Padding="15,6" FontSize="11"/>
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,15">
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="LEVEL NAME" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding TitleCountText}" Foreground="{DynamicResource FgSecondary}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Bottom"/>
                </DockPanel>
                <TextBox Text="{Binding LevelName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
             </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,25">
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="DESCRIPTION" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding DescCountText}" Foreground="{DynamicResource FgSecondary}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Bottom"/>
                </DockPanel>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="100" VerticalContentAlignment="Top" MaxLength="1000"/>
             </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" Command="{Binding CancelCommand}" Style="{DynamicResource BtnSecondary}"/>
                <Button Content="SAVE" Command="{Binding SaveCommand}" Style="{DynamicResource BtnPrimary}"/>
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>