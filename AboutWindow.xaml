<Window x:Class="LbpArchiveToolkit.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" WindowStyle="None" BorderThickness="0" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources> 
        <Style x:Key="BtnActionBlue" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpCyan}"/>
            <Setter Property="Foreground" Value="#002D3D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7EE0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource BgPrimary}">

        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="32" Background="Transparent">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Style="{DynamicResource TitleBarCloseBtn}" Click="TitleBar_Close_Click"/>
                </StackPanel>
            </Grid>

            <ContentControl Style="{DynamicResource PopitCard}" Margin="20,5,20,25" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="LBP Archive Toolkit" Foreground="{DynamicResource LbpOrange}" FontSize="26" FontWeight="Black" TextAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtVersion" Text="Version 1.0" Foreground="{DynamicResource LbpCyan}" FontWeight="Bold" FontSize="14" TextAlignment="Center" Margin="0,0,0,20"/>
                    
                    <TextBlock Foreground="{DynamicResource FgPrimary}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30">
                        <Run Text="Created by GigsTheCat" FontSize="15"/>
                    </TextBlock>
                    
                    <Button Content="CLOSE" Style="{DynamicResource BtnActionBlue}" Width="120" HorizontalAlignment="Center" Click="BtnClose_Click"/>
                </StackPanel>
            </ContentControl>
        </DockPanel>
    </Border>
</Window>