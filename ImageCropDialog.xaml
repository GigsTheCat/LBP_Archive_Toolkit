<Window x:Class="LbpArchiveToolkit.ImageCropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop Level Icon" Width="550" Height="610"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Segoe UI" Topmost="False">

    <Window.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpCyan}"/>
            <Setter Property="Foreground" Value="#002D3D"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7EE0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpPink}"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A9F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ContentControl Style="{DynamicResource PopitCard}" Margin="25" Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Header -->
                <RowDefinition Height="Auto"/> <!-- Separator -->
                <RowDefinition Height="*"/>    <!-- Workspace Area -->
                <RowDefinition Height="Auto"/> <!-- Slider Zoom Controls -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header Area -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="CROP LEVEL ICON" Foreground="{DynamicResource LbpOrange}" FontSize="22" FontWeight="Black"/>
                <TextBlock Text="Drag the image to pan. Scroll or use the slider to zoom." Foreground="{DynamicResource FgSecondary}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 2. Separator Line -->
            <Rectangle Grid.Row="1" Fill="{DynamicResource BorderSubtle}" Height="2" RadiusX="1" RadiusY="1" Margin="0,0,0,20"/>

            <!-- 3. Workspace Cropper Box -->
            <Border Grid.Row="2" Width="484" Height="364" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="2" CornerRadius="8" ClipToBounds="True" Background="#111115" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="gridWorkspace" Background="Transparent" ClipToBounds="True"
                      MouseLeftButtonDown="GridWorkspace_MouseLeftButtonDown" 
                      MouseLeftButtonUp="GridWorkspace_MouseLeftButtonUp" 
                      MouseMove="GridWorkspace_MouseMove" 
                      MouseWheel="GridWorkspace_MouseWheel">
                    
                    <!-- This container holds the image and is rendered to RenderTargetBitmap -->
                    <Canvas x:Name="canvasWorkspace" Width="480" Height="360" Background="#120F1D" ClipToBounds="True">
                        <Image x:Name="imgSource" Stretch="Fill" RenderTransformOrigin="0,0">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="scaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                    <TranslateTransform x:Name="translateTransform" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Canvas>
                    
                    <!-- Semi-transparent overlay with a clear 320x176 center cutout -->
                    <Path Fill="#B0000000" IsHitTestVisible="False">
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0,0,480,360"/>
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <RectangleGeometry Rect="80,92,320,176"/>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>

                    <!-- Guide borders showing the crop boundary box -->
                    <Border Width="320" Height="176" BorderBrush="{DynamicResource LbpOrange}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- 4. Zoom Slider Control -->
            <Grid Grid.Row="3" Margin="0,15,0,20" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="-" Foreground="{DynamicResource FgSecondary}" FontSize="18" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Slider x:Name="sliderZoom" Grid.Column="1" Minimum="0.1" Maximum="4.0" Value="1.0" 
                        TickFrequency="0.01" IsSnapToTickEnabled="False"
                        VerticalAlignment="Center"
                        ValueChanged="SliderZoom_ValueChanged"/>
                <TextBlock Grid.Column="2" Text="+" Foreground="{DynamicResource FgSecondary}" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <!-- 5. Action Footer Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" Style="{StaticResource BtnSecondary}" Click="BtnCancel_Click"/>
                <Button Content="APPLY" Style="{StaticResource BtnPrimary}" Click="BtnApply_Click"/>
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>