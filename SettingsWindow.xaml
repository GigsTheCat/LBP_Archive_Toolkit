<Window x:Class="LbpArchiveToolkit.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="650" Width="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" WindowStyle="None" BorderThickness="0" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
                
        <!-- TYPOGRAPHY -->
        <Style TargetType="TextBlock" x:Key="LabelText">
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="{DynamicResource LbpCyan}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,20,0,12"/>
        </Style>

        <Style TargetType="Rectangle" x:Key="Separator">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Fill" Value="{DynamicResource BgCardDarker}"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
        </Style>

        <!-- COMBOBOX THEME -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{DynamicResource BgCardDarker}" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource LbpCyan}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource BorderSubtle}"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource BorderSubtle}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton" Template="{StaticResource ComboBoxToggleButton}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Focusable="false"/>
                            <ContentPresenter x:Name="contentPresenter" IsHitTestVisible="False" Margin="12,0,30,0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource LbpPink}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, ElementName=toggleButton}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="2,4,2,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LbpPink}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CUSTOM ROUNDED CHECKBOX THEME -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="checkBoxBorder" Width="22" Height="22" Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="2" CornerRadius="6" VerticalAlignment="Center">
                                <Path x:Name="checkMark" Data="M4,11 L9,16 L17,6" Stroke="{DynamicResource LbpCyan}" StrokeThickness="3" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource LbpCyan}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="{DynamicResource BorderSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource BgPrimary}">

       <Grid>
            <ContentControl Template="{DynamicResource AnimatedBgTemplate}" IsHitTestVisible="False"/>
        <DockPanel>
            <!-- Title Bar -->
            <Grid DockPanel.Dock="Top" Height="32" Background="Transparent">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Style="{StaticResource TitleBarCloseBtn}" Click="TitleBar_Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Main Card Window -->
            <ContentControl Style="{DynamicResource PopitCard}" Margin="20,10,20,25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> 
                        <RowDefinition Height="*"/>    
                        <RowDefinition Height="Auto"/> 
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="25,20,25,15">
                        <TextBlock Text="CONFIG EDITOR" Foreground="{DynamicResource LbpOrange}" FontWeight="Black" FontSize="20"/>
                    </Border>

                    <!-- BODY -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="25,0,25,25">
                            
                            <!-- DIRECTORIES SECTION -->
                            <TextBlock Text="PATHS &amp; DIRECTORIES" Style="{StaticResource SectionHeader}" Margin="0,15,0,12"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Database Path:" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="txtDbPath" Grid.Row="0" Grid.Column="1" Margin="0,6,10,6"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="Browse" Style="{DynamicResource BubbleButton}" Background="{DynamicResource BorderSubtle}" Margin="0,6,0,6" Padding="15,6" Click="BtnBrowseDb_Click"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Backup Directory:" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="txtBackupDir" Grid.Row="1" Grid.Column="1" Margin="0,6,10,6"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse" Style="{DynamicResource BubbleButton}" Background="{DynamicResource BorderSubtle}" Margin="0,6,0,6" Padding="15,6" Click="BtnBrowseBackup_Click"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Local Archive Path:" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="txtLocalArchive" Grid.Row="2" Grid.Column="1" Margin="0,6,10,6"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="Browse" Style="{DynamicResource BubbleButton}" Background="{DynamicResource BorderSubtle}" Margin="0,6,0,6" Padding="15,6" Click="BtnBrowseLocalArchive_Click"/>
                            </Grid>

                            <Rectangle Style="{StaticResource Separator}"/>

                            <!-- NETWORK SECTION -->
                            <TextBlock Text="NETWORK &amp; DOWNLOADS" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Download Server:" Style="{StaticResource LabelText}"/>
                                <ComboBox x:Name="cmbServer" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="200" Margin="0,6,0,6">
                                    <ComboBoxItem Content="zaprit"/>
                                    <ComboBoxItem Content="bonsai"/>
                                    <ComboBoxItem Content="archive"/>
                                    <ComboBoxItem Content="local"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Parallel Downloads:" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="txtThreads" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Width="80" Margin="0,6,0,6"/>
                            </Grid>
                            
                            <!-- APPEARANCE SECTION -->
                            <Rectangle Style="{StaticResource Separator}"/>

                            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="App Theme:" Style="{StaticResource LabelText}"/>
                                <ComboBox x:Name="cmbTheme" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="200" Margin="0,6,0,6" SelectionChanged="CmbTheme_SelectionChanged">
                                    <!-- Items are populated dynamically from ThemeManager -->
                                </ComboBox>
                            </Grid>

                            <!-- BEHAVIOR SECTION -->
                            <TextBlock Text="ADVANCED BEHAVIOR" Style="{StaticResource SectionHeader}"/>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Backup Game Region:" Style="{StaticResource LabelText}" Width="160"/>
                                    <ComboBox x:Name="cmbRegion" HorizontalAlignment="Left" Width="200">
                                        <ComboBoxItem Content="US (NTSC-U)"/>
                                        <ComboBoxItem Content="EU (PAL)"/>
                                        <ComboBoxItem Content="JP (NTSC-J)"/>
                                    </ComboBox>
                                </DockPanel>
                                <CheckBox x:Name="chkForceLbp3" Content="Force LBP3 Backups (Useful if playing on retail LBP3)"/>
                                <CheckBox x:Name="chkLbp2Beta" Content="LBP2 Beta to Retail (Enable if importing corrupt errors)"/>
                                <CheckBox x:Name="chkUseMmap" Content="Use mmap for database (faster search, uses more RAM)"/>
                            </StackPanel>

                            <Rectangle Style="{StaticResource Separator}"/>

                            <!-- DATA MANAGEMENT SECTION -->
                            <TextBlock Text="DATA MANAGEMENT" Style="{StaticResource SectionHeader}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Forget Saved Levels" Style="{DynamicResource BubbleButton}" Background="{DynamicResource BorderSubtle}" Padding="15,8" Margin="0,0,10,0" Click="BtnForgetLevels_Click"/>
                                <Button Content="Reset to Default" Style="{DynamicResource BubbleButton}" Background="{DynamicResource BorderSubtle}" Padding="15,8" Click="BtnResetDefaults_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- FOOTER -->
                    <Border Grid.Row="2" Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15" Padding="25,15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="CANCEL" Style="{DynamicResource BubbleButton}" Background="{DynamicResource BorderSubtle}" Margin="0,0,15,0" MinWidth="120" Click="BtnCancel_Click"/>
                            <Button Content="SAVE SETTINGS" Style="{DynamicResource BubbleButton}" Background="{DynamicResource LbpEmerald}" Foreground="#003D2A" MinWidth="150" Click="BtnSave_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ContentControl>
        </DockPanel>
   </Grid>
    </Border>
</Window>