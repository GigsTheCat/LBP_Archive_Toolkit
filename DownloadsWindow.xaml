<Window x:Class="LbpArchiveToolkit.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloads" Height="600" Width="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" WindowStyle="None" BorderThickness="0" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BtnExtract" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpEmerald}"/>
            <Setter Property="Foreground" Value="#003D2A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#38E8B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource BgPrimary}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="32" Background="Transparent">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Style="{DynamicResource TitleBarCloseBtn}" Click="TitleBar_Close_Click"/>
                </StackPanel>
            </Grid>

            <ContentControl Style="{DynamicResource PopitCard}" Margin="20,5,20,25" Padding="25">
                <StackPanel>
                    <TextBlock Text="DATABASE DOWNLOADS" Foreground="{DynamicResource LbpOrange}" FontSize="22" FontWeight="Black" Margin="0,0,0,5"/>
                    <TextBlock Text="Choose a database version to download. Larger databases contain more search features but require more hard drive space." Foreground="{DynamicResource FgSecondary}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- Basic DB -->
                    <Border Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Basic Database (2.5 GB)" Foreground="{DynamicResource LbpCyan}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Standard level data. No advanced search indices." Foreground="{DynamicResource FgPrimary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="DOWNLOAD" Style="{StaticResource BtnExtract}" VerticalAlignment="Center" Command="{Binding DownloadBasicDbCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Fast DB -->
                    <Border Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Fast Database (5.5 GB)" Foreground="{DynamicResource LbpCyan}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Includes FTS5 (faster searching) + Level Contributors." Foreground="{DynamicResource FgPrimary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="DOWNLOAD" Style="{StaticResource BtnExtract}" VerticalAlignment="Center" Command="{Binding DownloadFastDbCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Full Fast DB -->
                    <Border Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Full Fast Database (15 GB)" Foreground="{DynamicResource LbpCyan}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Includes FTS5 + Level &amp; Object Contributors." Foreground="{DynamicResource FgPrimary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="DOWNLOAD" Style="{StaticResource BtnExtract}" VerticalAlignment="Center" Command="{Binding DownloadFullFastDbCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Ultimate DB -->
                    <Border Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Ultimate Database (20 GB)" Foreground="{DynamicResource LbpCyan}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Includes FTS5 + Level &amp; Object Contributors + Object Origins. All features available." Foreground="{DynamicResource FgPrimary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="DOWNLOAD" Style="{StaticResource BtnExtract}" VerticalAlignment="Center" Command="{Binding DownloadUltimateDbCommand}"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ContentControl>
        </DockPanel>
    </Border>
</Window>