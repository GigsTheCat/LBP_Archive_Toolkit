<Window x:Class="LbpArchiveToolkit.CustomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alert" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Segoe UI" Topmost="False">
    
    <Window.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpCyan}"/>
            <Setter Property="Foreground" Value="#002D3D"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7EE0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpPink}"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A9F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="checkBoxBorder" Width="20" Height="20" Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="2" CornerRadius="5" VerticalAlignment="Center">
                                <Path x:Name="checkMark" Data="M3,10 L8,15 L16,5" Stroke="{DynamicResource LbpCyan}" StrokeThickness="3" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource LbpCyan}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="{DynamicResource BorderSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ContentControl Style="{DynamicResource PopitCard}" Margin="25" Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="txtTitle" Text="{Binding Title}" Foreground="{DynamicResource LbpOrange}" FontSize="22" FontWeight="Black" VerticalAlignment="Center"/>
            </DockPanel>

            <Rectangle Grid.Row="1" Fill="{DynamicResource BorderSubtle}" Height="2" RadiusX="1" RadiusY="1" Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="2" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,30">
                <TextBlock x:Name="txtMessage" Foreground="{DynamicResource FgPrimary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="24"/>
            </ScrollViewer>

            <Grid Grid.Row="3">
                <Button x:Name="btnCopy" Content="{Binding CopyButtonText}" Visibility="{Binding CopyVisibility}" Command="{Binding CopyCommand}" Style="{DynamicResource BtnSecondary}" HorizontalAlignment="Left" Margin="0"/>
                
                <CheckBox Content="{Binding CheckboxText}" Visibility="{Binding CheckboxVisibility}" IsChecked="{Binding IsCheckboxChecked}" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnNo" Content="NO" Visibility="{Binding YesNoVisibility}" Command="{Binding NoCommand}" Style="{DynamicResource BtnSecondary}"/>
                    <Button x:Name="btnYes" Content="YES" Visibility="{Binding YesNoVisibility}" Command="{Binding YesCommand}" Style="{DynamicResource BtnPrimary}"/>
                    <Button x:Name="btnOk" Content="OK" Visibility="{Binding OkVisibility}" Command="{Binding OkCommand}" Style="{DynamicResource BtnPrimary}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ContentControl>
</Window>