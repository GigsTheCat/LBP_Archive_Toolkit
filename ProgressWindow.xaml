<Window x:Class="LbpArchiveToolkit.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extracting..." Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Topmost="True"
        FontFamily="Segoe UI" WindowStyle="None" BorderThickness="0" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BtnCancel" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpPink}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A9F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource BgPrimary}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="32" Background="Transparent">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Style="{DynamicResource TitleBarCloseBtn}" Click="TitleBar_Close_Click"/>
                </StackPanel>
            </Grid>

            <ContentControl Style="{DynamicResource PopitCard}" Margin="20,10,20,25" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20" MinHeight="40">
                        <TextBlock x:Name="txtStatus" Text="{Binding StatusText}" 
                                   Foreground="{DynamicResource FgPrimary}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4"/>

                        <TextBlock x:Name="txtSubStatus" Text="{Binding SubStatusText}" 
                                   FontSize="11" FontWeight="Normal" TextWrapping="Wrap" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsErrorState}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource LbpOrange}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource BgCardDarker}" CornerRadius="9" Height="18" Margin="0,0,0,25" ClipToBounds="True">
                        <ProgressBar x:Name="pbProgress" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" Background="Transparent" Foreground="{DynamicResource LbpEmerald}" BorderThickness="0"/>
                    </Border>

                    <Button x:Name="btnCancel" Grid.Row="2" Content="{Binding CancelButtonText}" IsEnabled="{Binding CanCancel}" Command="{Binding CancelCommand}" Width="120"
                            HorizontalAlignment="Center" Style="{DynamicResource BtnCancel}"/>
                </Grid>
            </ContentControl>
        </DockPanel>
    </Border>
</Window>