<Window x:Class="LbpArchiveToolkit.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extracting..." Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Topmost="True"
        FontFamily="Segoe UI" WindowStyle="None" BorderThickness="0" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        
        
        <Style x:Key="TitleBarCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,14,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        
        <Style x:Key="BtnCancel" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpPink}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A9F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource BgPrimary}">

      

        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="32" Background="Transparent">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Style="{DynamicResource TitleBarCloseBtn}" Click="TitleBar_Close_Click"/>
                </StackPanel>
            </Grid>

            <ContentControl Style="{DynamicResource PopitCard}" Margin="20,10,20,25" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20" MinHeight="40">
                        <TextBlock x:Name="txtStatus" Text="Preparing extraction..." 
                                   Foreground="{DynamicResource FgPrimary}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4"/>

                        <TextBlock x:Name="txtSubStatus" Text="Initializing..." 
                                   Foreground="{DynamicResource FgSecondary}" FontSize="11" FontWeight="Normal"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource BgCardDarker}" CornerRadius="9" Height="18" Margin="0,0,0,25" ClipToBounds="True">
                        <ProgressBar x:Name="pbProgress" Background="Transparent" Foreground="{DynamicResource LbpEmerald}" BorderThickness="0"/>
                    </Border>

                    <Button x:Name="btnCancel" Grid.Row="2" Content="CANCEL" Width="120"
                            HorizontalAlignment="Center" Style="{DynamicResource BtnCancel}" Click="BtnCancel_Click"/>
                </Grid>
            </ContentControl>
        </DockPanel>
   
    </Border>
</Window>