<Window x:Class="LbpArchiveToolkit.MissingDatabaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Missing Database" Width="550" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Segoe UI" Topmost="False">
    
    <Window.Resources>
        <SolidColorBrush x:Key="BgCard" Color="#2D2447"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#453868"/>
        <SolidColorBrush x:Key="FgPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="LbpOrange" Color="#FFB703"/>
        <SolidColorBrush x:Key="LbpPink" Color="#F72585"/>
        <SolidColorBrush x:Key="LbpCyan" Color="#4CC9F0"/>
        <SolidColorBrush x:Key="LbpEmerald" Color="#06D6A0"/>

        
        <Style x:Key="BubbleButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="20"> 
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3D325C"/>
                                <Setter Property="Foreground" Value="#6A5C8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base sizing for the dialog's buttons to make them big and chunky -->
        <Style x:Key="DialogButtonBase" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
        </Style>

        <Style x:Key="BtnSettings" TargetType="Button" BasedOn="{StaticResource DialogButtonBase}">
            <Setter Property="Background" Value="{StaticResource LbpCyan}"/>
            <Setter Property="Foreground" Value="#002D3D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7EE0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDownload" TargetType="Button" BasedOn="{StaticResource DialogButtonBase}">
            <Setter Property="Background" Value="{StaticResource LbpEmerald}"/>
            <Setter Property="Foreground" Value="#003D2A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#38E8B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="BtnClose" TargetType="Button" BasedOn="{StaticResource DialogButtonBase}">
            <Setter Property="Background" Value="{StaticResource LbpPink}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A9F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Margin="25" Padding="25">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#19132B" Offset="0.0" />
                <GradientStop Color="#2D2447" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.4" Direction="270" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Database Missing" Foreground="{StaticResource LbpOrange}" FontSize="22" FontWeight="Black" VerticalAlignment="Center"/>
            </DockPanel>

            <Rectangle Grid.Row="1" Fill="{StaticResource BorderSubtle}" Height="2" RadiusX="1" RadiusY="1" Margin="0,0,0,20"/>

            <TextBlock Grid.Row="2" Text="Could not find dry.db" Foreground="{StaticResource FgPrimary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,30"/>

            <!-- Buttons use the new chunkier style -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="SETTINGS" Style="{StaticResource BtnSettings}" Click="BtnSettings_Click"/>
                <Button Content="DOWNLOAD" Style="{StaticResource BtnDownload}" Click="BtnDownload_Click"/>
                <Button Content="CLOSE" Style="{StaticResource BtnClose}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>