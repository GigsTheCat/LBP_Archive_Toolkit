<Window x:Class="LbpArchiveToolkit.AdvancedSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Filters" Height="650" Width="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" WindowStyle="None" BorderThickness="0" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>   
        
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="#453868"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#574880"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpEmerald}"/>
            <Setter Property="Foreground" Value="#003D2A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#29E3B4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
                
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="{DynamicResource LbpCyan}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,20,0,12"/>
        </Style>

        <Style TargetType="Rectangle" x:Key="Separator">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Fill" Value="{DynamicResource BgCardDarker}"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
        </Style>
        
        <!-- Standard CheckBox (Used for normal list properties like 'Team Picked') -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="checkBoxBorder" Width="20" Height="20" Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="2" CornerRadius="6" VerticalAlignment="Center">
                                <Path x:Name="checkMark" Data="M4,10 L8,14 L15,5" Stroke="{DynamicResource LbpCyan}" StrokeThickness="3" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource LbpCyan}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#3D325C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Dynamic Game Label Sticker Style -->
        <Style x:Key="TagCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="Background" Value="#3D325C"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6"
                                Margin="1,1,2,2"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.4" Direction="315" Color="Black"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource FgPrimary}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource FgPrimary}"/>
                                <Setter Property="Foreground" Value="#151020"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource LbpCyan}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource LbpCyan}"/>
                                <Setter Property="Foreground" Value="#002D3D"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.04" ScaleY="1.04"/></Setter.Value>
                                </Setter>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#151020"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.04" ScaleY="1.04"/></Setter.Value>
                                </Setter>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource BgPrimary}">

        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="32" Background="Transparent">
                <TextBlock Text="Advanced Search Filters" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Style="{StaticResource TitleBarCloseBtn}" Click="TitleBar_Close_Click"/>
                </StackPanel>
            </Grid>

            <ContentControl Style="{DynamicResource PopitCard}" Margin="20,10,20,25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>   
                        <RowDefinition Height="Auto"/> 
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="25,20,25,15">
                        <TextBlock Text="ADVANCED FILTERS" Foreground="{DynamicResource LbpOrange}" FontWeight="Black" FontSize="20"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="25,0,25,25">
                            
                            <!-- NUMERIC FILTERS -->
                            <TextBlock Text="POPULARITY" Style="{StaticResource SectionHeader}" Margin="0,15,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="Min Hearts:" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtMinHearts" Grid.Column="1" Text="0" Width="80" HorizontalAlignment="Left"/>
                                
                                <TextBlock Grid.Column="2" Text="Min Plays:" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,10,0"/>
                                <TextBox x:Name="txtMinPlays" Grid.Column="3" Text="0" Width="80" HorizontalAlignment="Left"/>
                            </Grid>
                            
                            <CheckBox x:Name="chkTeamPick" Content="Team Picked Levels Only" Margin="0,15,0,0"/>

                            <Rectangle Style="{StaticResource Separator}"/>

                            <!-- LBP2 & LBP3 LABELS -->
                            <TextBlock Text="LBP2 &amp; LBP3 LABELS" Style="{StaticResource SectionHeader}"/>
                            
                            <TextBlock Text="Experience" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <WrapPanel x:Name="wpLbp2ExperienceLabels" Orientation="Horizontal" Margin="10,0,0,10"/>
                            
                            <TextBlock Text="Type" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <WrapPanel x:Name="wpLbp2TypeLabels" Orientation="Horizontal" Margin="10,0,0,10"/>
                            
                            <TextBlock Text="Content" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <WrapPanel x:Name="wpLbp2ContentLabels" Orientation="Horizontal" Margin="10,0,0,15"/>

                            <Rectangle Style="{StaticResource Separator}"/>

                            <!-- LBP3 ONLY LABELS -->
                            <TextBlock Text="LBP3 ONLY LABELS" Style="{StaticResource SectionHeader}"/>
                            
                            <TextBlock Text="Experience" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <WrapPanel x:Name="wpLbp3ExperienceLabels" Orientation="Horizontal" Margin="10,0,0,10"/>
                            
                            <TextBlock Text="Type" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <WrapPanel x:Name="wpLbp3TypeLabels" Orientation="Horizontal" Margin="10,0,0,10"/>
                            
                            <TextBlock Text="Content" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <WrapPanel x:Name="wpLbp3ContentLabels" Orientation="Horizontal" Margin="10,0,0,15"/>

                            <Rectangle Style="{StaticResource Separator}"/>

                            <!-- LBP1 TAGS -->
                            <TextBlock Text="LBP1 TAGS" Style="{StaticResource SectionHeader}"/>
                            <WrapPanel x:Name="wpLbp1Tags" Orientation="Horizontal" Margin="0,5,0,15"/>
                            
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15" Padding="25,15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="CLEAR ALL" Style="{StaticResource BtnSecondary}" Margin="0,0,15,0" MinWidth="100" Click="BtnClear_Click"/>
                            <Button Content="APPLY FILTERS" Style="{StaticResource BtnPrimary}" Margin="0,0,15,0" MinWidth="120" Click="BtnApply_Click"/>
                            <Button Content="APPLY &amp; SEARCH" Style="{StaticResource BtnPrimary}" MinWidth="140" Click="BtnApplyAndSearch_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ContentControl>
        </DockPanel>
    </Border>
</Window>