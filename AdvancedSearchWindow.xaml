<Window x:Class="LbpArchiveToolkit.AdvancedSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Filters" Height="900" Width="700"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" WindowStyle="None" BorderThickness="0" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>   
        
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="#453868"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#574880"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{DynamicResource LbpEmerald}"/>
            <Setter Property="Foreground" Value="#003D2A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#29E3B4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
                
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="{DynamicResource LbpCyan}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,15,0,8"/>
        </Style>

        <Style TargetType="Rectangle" x:Key="Separator">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Fill" Value="{DynamicResource BgCardDarker}"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
        </Style>

        <!-- COMBOBOX THEME -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{DynamicResource BgCardDarker}" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource LbpCyan}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource BorderSubtle}"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource BorderSubtle}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton" Template="{StaticResource ComboBoxToggleButton}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Focusable="false"/>
                            <ContentPresenter x:Name="contentPresenter" IsHitTestVisible="False" Margin="12,0,30,0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource LbpPink}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, ElementName=toggleButton}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="2,4,2,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LbpPink}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Add compact TextBox style -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Standard CheckBox (Used for normal list properties like 'Team Picked') -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="checkBoxBorder" Width="18" Height="18" Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="2" CornerRadius="5" VerticalAlignment="Center">
                                <Path x:Name="checkMark" Data="M3,9 L7,13 L14,4" Stroke="{DynamicResource LbpCyan}" StrokeThickness="3" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource LbpCyan}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#3D325C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Dynamic Game Label Sticker Style -->
        <Style x:Key="TagCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="Background" Value="#3D325C"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6"
                                Margin="1,1,2,2"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.4" Direction="315" Color="Black"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource FgPrimary}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource FgPrimary}"/>
                                <Setter Property="Foreground" Value="#151020"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource LbpCyan}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource LbpCyan}"/>
                                <Setter Property="Foreground" Value="#002D3D"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.04" ScaleY="1.04"/></Setter.Value>
                                </Setter>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#151020"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.04" ScaleY="1.04"/></Setter.Value>
                                </Setter>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reusable ItemsControl Style for binding collections of Tag Checkboxes -->
        <Style x:Key="TagItemsControl" TargetType="ItemsControl">
            <Setter Property="Margin" Value="10,0,0,10"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" 
                                  IsChecked="{Binding IsSelected}" 
                                  Margin="2"
                                  Style="{DynamicResource TagCheckBox}">
                            <CheckBox.LayoutTransform>
                                <RotateTransform Angle="{Binding TiltAngle}"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource BgPrimary}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="32" Background="Transparent">
                <TextBlock Text="Advanced Search Filters" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Style="{StaticResource TitleBarCloseBtn}" Click="TitleBar_Close_Click"/>
                </StackPanel>
            </Grid>

            <ContentControl Style="{DynamicResource PopitCard}" Margin="20,10,20,25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>   
                        <RowDefinition Height="Auto"/> 
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="25,20,25,15">
                        <TextBlock Text="ADVANCED FILTERS" Foreground="{DynamicResource LbpOrange}" FontWeight="Black" FontSize="20"/>
                    </Border>

                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border Name="Border" Padding="15,8" Margin="2,2,2,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource LbpCyan}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource LbpCyan}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#15FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </TabControl.Resources>

                        <TabItem Header="Requirements">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="25,0,25,25">
                                    
                                    <!-- NUMERIC FILTERS -->
                                    <TextBlock Text="POPULARITY" Style="{StaticResource SectionHeader}" Margin="0,15,0,12"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Row 0: Hearts & Plays -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Min Hearts:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MinHearts, UpdateSourceTrigger=PropertyChanged}" Width="85" HorizontalAlignment="Left"/>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Min Plays:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MinPlays, UpdateSourceTrigger=PropertyChanged}" Width="85" HorizontalAlignment="Left"/>
                                    
                                        <!-- Row 2: Heart & Yay Percentage -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Min Heart %:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <DockPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left">
                                            <TextBox Text="{Binding MinHeartPercentage, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left" Margin="0,0,5,0"/>
                                            <TextBlock Text="%" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Min Yay %:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,8,0"/>
                                        <DockPanel Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left">
                                            <TextBox Text="{Binding MinYayPercentage, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left" Margin="0,0,5,0"/>
                                            <TextBlock Text="%" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- Row 4: Min & Max Clear Percentage -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Min Clear %:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <DockPanel Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left">
                                            <TextBox Text="{Binding MinClearPercentage, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left" Margin="0,0,5,0"/>
                                            <TextBlock Text="%" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Max Clear %:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,8,0"/>
                                        <DockPanel Grid.Row="4" Grid.Column="3" HorizontalAlignment="Left">
                                            <TextBox Text="{Binding MaxClearPercentage, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left" Margin="0,0,5,0"/>
                                            <TextBlock Text="%" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Grid>

                            <TextBlock Text="PUBLISH DATE" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Published After:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding PublishedAfterYear}" Width="85" Margin="0,0,5,0" HorizontalContentAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding AvailableMonths}" SelectedItem="{Binding PublishedAfterMonth}" Width="70" HorizontalContentAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="Published Before:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,8,0"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding PublishedBeforeYear}" Width="85" Margin="0,0,5,0" HorizontalContentAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding AvailableMonths}" SelectedItem="{Binding PublishedBeforeMonth}" Width="70" HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            
                            <CheckBox Content="Team Picked Levels Only" IsChecked="{Binding IsTeamPick}" Margin="0,10,0,0"/>
                            <CheckBox Content="Locked Levels Only" IsChecked="{Binding RequireLocked}" Margin="0,5,0,0"/>
                            <CheckBox Content="Sub-levels Only" IsChecked="{Binding RequireSubLevel}" Margin="0,5,0,0"/>
                            <CheckBox Content="Copyable Levels Only" IsChecked="{Binding RequireShareable}" Margin="0,5,0,0"/>

                            <Rectangle Style="{StaticResource Separator}"/>

                            <!-- LBP2 & LBP3 LABELS -->
                            <TextBlock Text="LBP2 &amp; LBP3 LABELS" Style="{StaticResource SectionHeader}"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,10">
                                <TextBlock Text="Label Match Mode:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox SelectedIndex="{Binding LabelMatchMode}" Width="200" HorizontalAlignment="Left" Margin="0">
                                    <ComboBoxItem Content="Author or Community"/>
                                    <ComboBoxItem Content="Author Labels Only"/>
                                    <ComboBoxItem Content="Community Labels Only"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <TextBlock Text="Experience" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <ItemsControl ItemsSource="{Binding Lbp2ExperienceLabels}" Style="{StaticResource TagItemsControl}"/>
                            
                            <TextBlock Text="Type" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <ItemsControl ItemsSource="{Binding Lbp2TypeLabels}" Style="{StaticResource TagItemsControl}"/>
                            
                            <TextBlock Text="Content" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <ItemsControl ItemsSource="{Binding Lbp2ContentLabels}" Margin="10,0,0,15" Style="{StaticResource TagItemsControl}"/>

                            <Rectangle Style="{StaticResource Separator}"/>

                            <!-- LBP3 ONLY LABELS -->
                            <TextBlock Text="LBP3 ONLY LABELS" Style="{StaticResource SectionHeader}"/>
                            
                            <TextBlock Text="Experience" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <ItemsControl ItemsSource="{Binding Lbp3ExperienceLabels}" Style="{StaticResource TagItemsControl}"/>
                            
                            <TextBlock Text="Type" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <ItemsControl ItemsSource="{Binding Lbp3TypeLabels}" Style="{StaticResource TagItemsControl}"/>
                            
                            <TextBlock Text="Content" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <ItemsControl ItemsSource="{Binding Lbp3ContentLabels}" Style="{StaticResource TagItemsControl}"/>

                            <TextBlock Text="Characters" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                            <ItemsControl ItemsSource="{Binding Lbp3CharacterLabels}" Margin="10,0,0,15" Style="{StaticResource TagItemsControl}"/>

                            <Rectangle Style="{StaticResource Separator}"/>

                            <!-- LBP1 TAGS -->
                            <TextBlock Text="LBP1 TAGS" Style="{StaticResource SectionHeader}"/>
                            <ItemsControl ItemsSource="{Binding Lbp1Tags}" Margin="0,5,0,15" Style="{StaticResource TagItemsControl}"/>
                            
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Exclusions">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="25,0,25,25">
                                    
                                    <TextBlock Text="EXCLUSION CRITERIA" Style="{StaticResource SectionHeader}"/>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Exclude Creators:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ExcludedCreators, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma separated list of PSN IDs"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Exclude Contributors:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ExcludedContributors, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma separated list of PSN IDs"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Exclude Objects By:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ExcludedObjectContributors, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma separated list of PSN IDs"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="Max Hearts:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding MaxHearts, UpdateSourceTrigger=PropertyChanged}" Width="85" HorizontalAlignment="Left"/>
                                        
                                        <TextBlock Grid.Column="2" Text="Max Plays:" Foreground="{DynamicResource FgSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,8,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding MaxPlays, UpdateSourceTrigger=PropertyChanged}" Width="85" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <CheckBox Content="Exclude Team Picked Levels" IsChecked="{Binding ExcludeTeamPick}" Margin="0,5,0,5"/>
                                    <CheckBox Content="Exclude Locked Levels" IsChecked="{Binding ExcludeLocked}" Margin="0,5,0,5"/>
                                    <CheckBox Content="Exclude Sub-levels" IsChecked="{Binding ExcludeSubLevels}" Margin="0,5,0,5"/>
                                    <CheckBox Content="Exclude Copyable Levels" IsChecked="{Binding ExcludeShareable}" Margin="0,5,0,5"/>

                                    <Rectangle Style="{StaticResource Separator}"/>

                                    <TextBlock Text="EXCLUDE LBP2 &amp; LBP3 LABELS" Style="{StaticResource SectionHeader}"/>
                                    
                                    <TextBlock Text="Experience" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                                    <ItemsControl ItemsSource="{Binding ExcludedLbp2ExperienceLabels}" Style="{StaticResource TagItemsControl}"/>
                                    
                                    <TextBlock Text="Type" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                                    <ItemsControl ItemsSource="{Binding ExcludedLbp2TypeLabels}" Style="{StaticResource TagItemsControl}"/>
                                    
                                    <TextBlock Text="Content" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                                    <ItemsControl ItemsSource="{Binding ExcludedLbp2ContentLabels}" Margin="10,0,0,15" Style="{StaticResource TagItemsControl}"/>

                                    <Rectangle Style="{StaticResource Separator}"/>

                                    <TextBlock Text="EXCLUDE LBP3 ONLY LABELS" Style="{StaticResource SectionHeader}"/>
                                    
                                    <TextBlock Text="Experience" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                                    <ItemsControl ItemsSource="{Binding ExcludedLbp3ExperienceLabels}" Style="{StaticResource TagItemsControl}"/>
                                    
                                    <TextBlock Text="Type" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                                    <ItemsControl ItemsSource="{Binding ExcludedLbp3TypeLabels}" Style="{StaticResource TagItemsControl}"/>
                                    
                                    <TextBlock Text="Content" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                                    <ItemsControl ItemsSource="{Binding ExcludedLbp3ContentLabels}" Style="{StaticResource TagItemsControl}"/>

                                    <TextBlock Text="Characters" Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11" Margin="10,5,0,5"/>
                                    <ItemsControl ItemsSource="{Binding ExcludedLbp3CharacterLabels}" Margin="10,0,0,15" Style="{StaticResource TagItemsControl}"/>

                                    <Rectangle Style="{StaticResource Separator}"/>

                                    <TextBlock Text="EXCLUDE LBP1 TAGS" Style="{StaticResource SectionHeader}"/>
                                    <ItemsControl ItemsSource="{Binding ExcludedLbp1Tags}" Margin="0,5,0,15" Style="{StaticResource TagItemsControl}"/>
                                    
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="2" Background="{DynamicResource BgCardDarker}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15" Padding="20,15">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="SAVE PRESET" Command="{Binding SavePresetCommand}" Style="{StaticResource BtnSecondary}" Padding="10,6" FontSize="11" Margin="0,0,8,0"/>
                                <Button Content="LOAD PRESET" Command="{Binding LoadPresetCommand}" Style="{StaticResource BtnSecondary}" Padding="10,6" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="CLEAR ALL" Command="{Binding ClearCommand}" Style="{StaticResource BtnSecondary}" Padding="10,6" FontSize="11" Margin="0,0,8,0"/>
                                <Button Content="APPLY FILTERS" Command="{Binding ApplyCommand}" Style="{StaticResource BtnPrimary}" Padding="10,6" FontSize="11" Margin="0,0,8,0"/>
                                <Button Content="APPLY &amp; SEARCH" Command="{Binding ApplyAndSearchCommand}" Style="{StaticResource BtnPrimary}" Padding="10,6" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ContentControl>
        </DockPanel>
    </Border>
</Window>